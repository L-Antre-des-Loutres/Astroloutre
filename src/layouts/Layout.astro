---
/* Global stuff & variables */
import "../styles/variables.css";
import "../styles/global.css"; // Only tailwind, to delete when done with tailwind

/* Specialized stylesheets */
import "../styles/global/text.css";
import "../styles/global/vignettes.css";
import "../styles/global/containers.css";
import "../styles/global/buttons.css";
import "../styles/global/rankings.css";

import "../styles/themes/classic-sombre.css"; /* Theme */
import "../styles/themes/classic.css"; /* Light Theme */

import Header from "../components/sections/layout/Header.astro";
import adl_logo from "../assets/adl_small_logo.png";
import Footer from "../components/sections/layout/Footer.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import Seo from "../components/sections/layout/Seo.astro";
import { SITE_NAME } from "../utils/seo";

// On définit des props optionnelles pour le layout
const {
    title = SITE_NAME,
    ogTitle,
    ogImage,
    ogImageAlt,
    ogDescription,
    ogType,
    noindex = false,
    forceDarkTheme = false,
} = Astro.props;

// Onglet du navigateur : "ADL | Nom de la page"
const pageTitle = title === SITE_NAME ? title : `ADL | ${title}`;

// Embed Discord : le nom du site est déjà affiché à part, on garde le titre nu.
const embedTitle = ogTitle ?? title;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href={adl_logo.src} />
        <meta name="generator" content={Astro.generator} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="google-adsense-account" content="ca-pub-6478246282898335">
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6478246282898335"
                crossorigin="anonymous"></script>

        <!-- Titre, description, canonical, Open Graph (embeds Discord) -->
        <Seo
            title={pageTitle}
            ogTitle={embedTitle}
            description={ogDescription}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            ogType={ogType}
            noindex={noindex}
        />

        <!-- Fonts import -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Festive&display=swap"
            rel="stylesheet"
        />
        <script is:inline define:vars={{ forceDarkTheme }}>
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme === "light" && !forceDarkTheme) {
                document.documentElement.classList.add("light-theme");
            } else if (forceDarkTheme) {
                document.documentElement.classList.remove("light-theme");
            }
        </script>
    </head>
    <body
        class="flex flex-col min-h-screen overflow-x-hidden"
        style="background-color: var(--background-color)"
    >
        <Header />
        <main class="grow">
            <slot />
        </main>
        <Footer />
        {!forceDarkTheme && <ThemeToggle />}
    </body>
</html>
