<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rickroll</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #0b0e14;
            overflow: hidden;
            font-family: system-ui, -apple-system, sans-serif;
        }
        
        #btn-container {
            text-align: center;
        }

        .badge-btn {
            background-color: #ff9800;
            color: white;
            border: none;
            padding: 20px 40px;
            font-size: 1.5rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 152, 0, 0.4);
            transition: transform 0.2s, background-color 0.2s;
        }

        .badge-btn:hover {
            background-color: #f57c00;
            transform: scale(1.05);
        }

        video {
            display: none;
            max-width: 100%;
            max-height: 100%;
        }
        
        body.playing {
            background-color: black;
        }
    </style>
</head>
<body>
    <div id="btn-container">
        <button id="activate-btn" class="badge-btn">Obtenir le badge</button>
    </div>

    <video id="rickroll" controls playsinline loop src="https://www.rickroll.it/rickroll.mp4">
        Votre navigateur ne supporte pas la lecture de vidéos.
    </video>

    <script is:inline>
        const btnContainer = document.getElementById('btn-container');
        const activateBtn = document.getElementById('activate-btn');
        const video = document.getElementById('rickroll');

        activateBtn.addEventListener('click', () => {
            // Cacher le bouton
            btnContainer.style.display = 'none';
            document.body.classList.add('playing');
            
            // Afficher et lancer la vidéo avec le son
            video.style.display = 'block';
            video.play();
        });
    </script>
</body>
</html>
