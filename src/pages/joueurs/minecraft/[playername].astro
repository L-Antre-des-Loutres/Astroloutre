---
import Banner from "../../../components/sections/layout/Banner.astro";
import PlayerStats from "../../../components/sections/joueurs/PlayerStatsData.astro";
import {slugify} from "../../../formater/JoueurFormater";
import Layout from "../../../layouts/Layout.astro";
import {formatDate} from "../../../formater/DateFormater";
import BadgeList from "../../../components/sections/badges/BadgeList.astro";
import TransitionSection from "../../../components/sections/common/transitions/TransitionSection.astro";
import {formatMinecraftPlayTime} from "../../../formater/MinecraftPlayTimeFormater";
import PokemonTeams from "../../../components/sections/joueurs/PokemonTeams.astro";

import {ApiFetcher} from "../../../utils/API/apiFetcher";
import type {PlayerStatsType, PlayerType} from "../../../types/PlayerType.ts";
import type {DiscordUserType} from "../../../types/UtilisateurDiscordType.ts";
import {DISCORD_USERS, PLAYERS, PLAYERS_STATS} from "../../../utils/constantes.ts";

// Props passées depuis getStaticPaths
const joueur: PlayerType | undefined = Astro.props.joueur;
const allRelatedPbIds: string[] = Astro.props.allRelatedPbIds || [];
const playtime = Astro.props.playtime || 0;

// Génération des pages statiques
export async function getStaticPaths() {

    // ──────────────────────────────────────────────
    // Récupération des informations
    // ──────────────────────────────────────────────

    const joueurs = await ApiFetcher.getAllRecords<PlayerType>(PLAYERS);
    const utilisateurs = await ApiFetcher.getAllRecords<DiscordUserType>(DISCORD_USERS);
    const allStats = await ApiFetcher.getAllRecords<PlayerStatsType>(PLAYERS_STATS);

    // Dédoublonnement par playername (on garde le record le plus récent)
    const playersByName = new Map<string, PlayerType>();
    
    // Tri par date de connexion pour avoir le plus récent
    const sortedJoueurs = [...joueurs].sort((a, b) => {
        const dateA = a.last_connected_at ? new Date(a.last_connected_at).getTime() : 0;
        const dateB = b.last_connected_at ? new Date(b.last_connected_at).getTime() : 0;
        return dateB - dateA;
    });

    sortedJoueurs.forEach(joueur => {
        const nameSlug = slugify(joueur.playername);
        if (!playersByName.has(nameSlug)) {
            playersByName.set(nameSlug, joueur);
        }
    });

    return Array.from(playersByName.values())
        .filter(joueur => joueur.playername.trim() !== '')
        .map(joueur => {
            // Associer le discord_tag si discord_user est présent
            const utilisateur = utilisateurs.find(u => u.id === joueur.discord_user);
            const discordTag = utilisateur ? utilisateur.discord_tag : null;

            // Aggréger le temps de jeu de TOUS les serveurs pour cet account_id
            const playerStats = allStats.filter(s => s.account_id === joueur.account_id);
            const totalTicks = playerStats.reduce((acc, curr) => acc + (Number(curr.playtime) || 0), 0);
            const playtime = formatMinecraftPlayTime(totalTicks);

            // Regrouper tous les records PocketBase pour ce même joueur (si doublons)
            const allRelatedPbIds = joueurs
                .filter(j => slugify(j.playername) === slugify(joueur.playername))
                .map(j => j.id);

            return {
                params: {
                    playername: slugify(joueur.playername),
                },
                props: {
                    joueur: {
                        ...joueur,
                        discord_tag: slugify(discordTag),
                    },
                    playtime,
                    allRelatedPbIds
                },
            };
        });
}


const voyelles = ['a', 'e', 'i', 'o', 'u', 'y', 'h'];
let prefixe = "de ";

if (joueur && joueur.playername && voyelles.includes(joueur.playername[0].toLowerCase())) {
    prefixe = "d’";
}

let profilLink
let profilText
if (!joueur || !joueur.discord_user) {
    profilLink = "#"
    profilText = "Lier ce profil"
} else {
    // Le compte joueur est lié à un profil discord
    profilLink = `/profil/${joueur.discord_tag}`
    profilText = "Profil Discord"
}
---

<Layout
        title={joueur.playername}
        ogTitle={`Profil Minecraft ${prefixe}${joueur.playername}`}
        ogDescription={`${joueur.playername} sur les serveurs Minecraft de l'Antre des Loutres : ${playtime}h de jeu, badges et statistiques.`}
        ogImage={`https://mc-heads.net/avatar/${joueur.playername}/512`}
        ogImageAlt={`Tête Minecraft ${prefixe}${joueur.playername}`}
        ogType="profile"
>
    <Banner bannerUrl={`/banner/minecraft/la_vanilla.webp`} />

    <TransitionSection title=`Profil ![/icons/logo_minecraft.svg] ${prefixe} #${joueur.playername}#`/>

    {joueur && (
        <div class="profile-container">
            <div class="profile-details">
                <div class="avatar">
                    <img src={`https://mc-heads.net/body/${joueur.playername}/128`} alt={`Avatar de ${joueur.playername}`} style="display: inline;" />
                </div>

                {/* Colonne 2 : Informations */}
                <div class="info-grid">
                    <h2>Informations</h2>

                    {/* Badges style */}
                    <div class="server-card-footer">
                        <span class="server-card-badge version">{joueur.playername}</span>
                    </div>

                    <div class="server-desc-container">
                        <div class="stats-row">
                            <label style="font-weight: bold; display: flex; align-items: center; gap: 6px;">
                                {/* Icône ID */}
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" width="18" height="18">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M5 13l4 4L19 7"/>
                                </svg>
                                UUID du compte :
                            </label>
                            <input
                                    type="text"
                                    value={joueur.account_id}
                                    readonly
                                    onclick="this.select()"
                                    style="margin-top: 4px; width: 100%; padding: 4px 8px; border: 1px solid var(--player-profile-border); background-color: var(--player-profile-input-bg); color: var(--player-profile-text-primary); border-radius: 4px; font-family: monospace;"
                            />
                        </div>
                        <div class="stats-row">
                            <strong>
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" width="18" height="18"
                                     style="vertical-align: middle; margin-right: 6px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Heures de jeux :
                            </strong>
                            <span>{playtime}h</span>
                        </div>

                        <div class="stats-row">
                            <strong>
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" width="18" height="18"
                                     style="vertical-align: middle; margin-right: 6px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                Première connexion :
                            </strong>
                            <span>{formatDate(joueur.first_connected_at)}</span>
                        </div>

                        <div class="stats-row">
                            <strong>
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" width="18" height="18"
                                     style="vertical-align: middle; margin-right: 6px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                Dernière connexion :
                            </strong>
                            <span>{formatDate(joueur.last_connected_at)}</span>
                        </div>
                    </div>
                </div>

                {/* Colonne 3 : Actions */}
                <div class="info-grid">
                    <h2>Action</h2>
                    <button class="button-copy super-button golden-outline"
                            data-uuid={joueur.account_id}>
                        <span style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                        <img src={`https://mc-heads.net/avatar/${joueur.playername}/32`} alt="Copier UUID"/>
                        <span>Copier UUID</span>
                            </span>
                    </button>
                    <a class="super-button golden-outline" href={`https://fr.namemc.com/profile/${joueur.playername}`}
                       target="_blank" rel="noopener noreferrer">
                        <img src="/icons/namemc.png" alt="NameMC" class="svg"/>
                        Profil NameMC
                    </a>
                    {profilLink !== "#" && (
                        <>
                            <a class="super-button golden-outline" href={`${profilLink}`}>
                                <svg width="800px" height="800px" viewBox="0 -28.5 256 256" version="1.1"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                     preserveAspectRatio="xMidYMid">
                                    <g>
                                        <path d="M216.856339,16.5966031 C200.285002,8.84328665 182.566144,3.2084988 164.041564,0 C161.766523,4.11318106 159.108624,9.64549908 157.276099,14.0464379 C137.583995,11.0849896 118.072967,11.0849896 98.7430163,14.0464379 C96.9108417,9.64549908 94.1925838,4.11318106 91.8971895,0 C73.3526068,3.2084988 55.6133949,8.86399117 39.0420583,16.6376612 C5.61752293,67.146514 -3.4433191,116.400813 1.08711069,164.955721 C23.2560196,181.510915 44.7403634,191.567697 65.8621325,198.148576 C71.0772151,190.971126 75.7283628,183.341335 79.7352139,175.300261 C72.104019,172.400575 64.7949724,168.822202 57.8887866,164.667963 C59.7209612,163.310589 61.5131304,161.891452 63.2445898,160.431257 C105.36741,180.133187 151.134928,180.133187 192.754523,160.431257 C194.506336,161.891452 196.298154,163.310589 198.110326,164.667963 C191.183787,168.842556 183.854737,172.420929 176.223542,175.320965 C180.230393,183.341335 184.861538,190.991831 190.096624,198.16893 C211.238746,191.588051 232.743023,181.531619 254.911949,164.955721 C260.227747,108.668201 245.831087,59.8662432 216.856339,16.5966031 Z M85.4738752,135.09489 C72.8290281,135.09489 62.4592217,123.290155 62.4592217,108.914901 C62.4592217,94.5396472 72.607595,82.7145587 85.4738752,82.7145587 C98.3405064,82.7145587 108.709962,94.5189427 108.488529,108.914901 C108.508531,123.290155 98.3405064,135.09489 85.4738752,135.09489 Z M170.525237,135.09489 C157.88039,135.09489 147.510584,123.290155 147.510584,108.914901 C147.510584,94.5396472 157.658606,82.7145587 170.525237,82.7145587 C183.391518,82.7145587 193.761324,94.5189427 193.539891,108.914901 C193.539891,123.290155 183.391518,135.09489 170.525237,135.09489 Z"
                                              fill="#5865F2" fill-rule="nonzero">
                                        </path>
                                    </g>
                                </svg>
                                {profilText}
                            </a>
                        </>
                    )}
                </div>
            </div>

            <TransitionSection title={`%Statistiques% ${prefixe} #${joueur.playername}#`}/>

            <PlayerStats uuid={joueur.account_id} />

            <TransitionSection
                    title={`Badges ![/icons/logo_minecraft.svg] optenus`}
            />

            <BadgeList PlayerOrUser="player" userId={joueur.id} categoryId={2} allRelatedPbIds={allRelatedPbIds} />

            <TransitionSection
                    title={`Pokemon ${prefixe} #${joueur.playername}#`}
            />

            <PokemonTeams uuid={joueur.account_id}/>

        </div>
    )}

    <style>
        .profile-container {
            border-radius: 10px;
            text-align: center;
            font-family: Arial, sans-serif;
        }

        h2 {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            color: var(--player-profile-text-primary);
        }

        .profile-details {
            color: var(--player-profile-text-primary);
            display: grid;
            grid-template-columns: 0.6fr 1fr 0.6fr;
            gap: 1rem;
            align-items: flex-start;
            justify-items: center;
            padding: 2rem;
        }

        .avatar,
        .info-grid {
            width: 100%;
        }

        .avatar img {
            border-radius: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            font-size: 0.9rem;
            text-align: left;
        }

        .server-desc-container {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Crée 2 colonnes de largeur égale */
            gap: 1rem; /* Espace entre les cellules */
            width: 100%;
        }

        .stats-row {
            display: flex;
            flex-direction: column;
            background-color: var(--player-profile-card-bg);
            padding: 0.8rem;
            border-radius: 8px;
            text-align: left; /* Ou center selon votre préférence */
        }

        /* Optionnel : Passer à 1 colonne sur mobile */
        @media (max-width: 600px) {
            .server-desc-container {
                grid-template-columns: 1fr;
            }
        }

        .stats-row {
            display: flex;
            flex-direction: column;
        }

        .icon {
            display: inline;
            vertical-align: text-bottom;
            margin-right: 6px;
            color: var(--player-profile-icon-color);
        }

        button.super-button {
            width: 100%;
            font-size: 1em;
            justify-self: center;
            align-self: center;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0.5rem 1rem;
        }

        @media (max-width: 990px) {
            .profile-details {
                grid-template-columns: 1fr;
            }

            .info-grid {
                text-align: center;
            }

            .stats-row {
                align-items: center;
            }
        }
    </style>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const buttons = document.querySelectorAll(".button-copy");

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    const uuid = button.getAttribute("data-uuid");
                    navigator.clipboard.writeText(uuid).then(() => {
                        const span = button.querySelector("span");
                        const originalText = span.textContent;
                        span.textContent = "UUID copié !";
                        setTimeout(() => {
                            span.textContent = originalText;
                        }, 2000);
                    });
                });
            });
        });
    </script>
</Layout>
