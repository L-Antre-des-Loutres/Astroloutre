---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import LargeBanner from "../components/transitions/LargeBanner.astro";

interface Props {
    error: unknown;
}
const { error = 500 } = Astro.props;
---

<Layout title="Erreur 404">
    <Banner/>
    <div class="error-page-content">
        <LargeBanner title=`Erreur %#${error}#% !` invertedBackground/>
        <p>
            Une erreur… Vaut mieux <a href="/">retourner en lieu sûr</a>, pas vrai ?
        </p>
    </div>
</Layout>

<style>
    a {
        color: #3572b5;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }

    p {
        text-align: center;
    }
</style>
