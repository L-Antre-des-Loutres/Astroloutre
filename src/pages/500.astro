---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/sections/layout/Banner.astro";
import LargeTransitionSection from "../components/sections/common/transitions/LargeTransitionSection.astro";

interface Props {
    error: unknown;
}
const { error = 500 } = Astro.props;
---

<Layout
        title="Erreur 500"
        ogDescription="Une erreur est survenue de notre côté. Les loutres réparent ça au plus vite !"
        noindex
>
    <Banner/>
    <div class="error-page-content">
        <LargeTransitionSection title=`Erreur %#${error}#% !` invertedBackground/>
        <p style="text-align: center;">
            Une erreur est survenue… Vaut mieux <a class="link" href="/">retourner en lieu sûr</a>, pas vrai ?
        </p>
    </div>
</Layout>

<style>
    .link {
        color: #3572b5;
        text-decoration: none;
    }
    .link:hover {
        text-decoration: underline;
    }
</style>
