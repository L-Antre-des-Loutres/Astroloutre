---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/sections/layout/Banner.astro";
import LargeTransitionSection from "../components/sections/common/transitions/LargeTransitionSection.astro";
---

<Layout
        title="Erreur 404"
        ogDescription="Cette page n'existe pas, ou plus… Vaut mieux retourner en lieu sûr !"
        noindex
>
    <Banner/>
    <div class="error-page-content">
        <LargeTransitionSection
                title="%#404#% Page non trouvée !"
                invertedBackground
        />
        <p>
            Cette page n'existe pas, ou plus… Vaut mieux <a href="/"
        >retourner en lieu sûr</a
        >, pas vrai ?
        </p>
    </div>
</Layout>

<style>
    a {
        color: #3572b5;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }

    p {
        text-align: center;
    }
</style>
