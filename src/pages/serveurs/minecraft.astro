---
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import LargeTransitionSection from "../../components/sections/common/transitions/LargeTransitionSection.astro";
import type {ServeurType} from "../../types/ServeurType.ts";
import {slugify} from "../../formater/JoueurFormater.ts";
import GameServerVignette from "../../components/ui/vignettes/GameServerVignette.astro";

import {ApiFetcher} from "../../utils/API/apiFetcher";
import {SERVERS, PB_URL} from "../../utils/constantes";

const jeu = 'minecraft';

// Récupération des données depuis PocketBase
const serversRaw = await ApiFetcher.getAllRecords<ServeurType>(SERVERS, {
    expand: 'platform',
    sort: '-is_enabled'
});

const data = serversRaw
    .filter(item => {
        const pName = item.expand?.platform?.name?.toLowerCase() || "";
        return pName === 'minecraft';
    })
    .map(item => ({
        ...item,
        // Construction de l'URL de l'image PocketBase si c'est une image stockée, sinon image par défaut
        image: item.image ? `${PB_URL}/api/files/${item.collectionId}/${item.id}/${item.image}` : "/banner/minecraft/nos_serveurs.webp"
    }));
---

<Layout
        title="Serveurs Minecraft"
        ogDescription="Tous les serveurs Minecraft de l'Antre des Loutres : vanilla, moddés, créatif… viens jouer avec la communauté !"
        ogImage="/banner/minecraft/nos_serveurs.webp"
        ogImageAlt="Les serveurs Minecraft de l'Antre des Loutres"
>

<Banner bannerUrl="/banner/minecraft/nos_serveurs.webp"/>

<LargeTransitionSection title="%Nos serveurs% ![https://www.minecraft.net/content/dam/minecraftnet/games/minecraft/logos/Global-Header_MCCB-Logo_300x51.svg]" invertedBackground/>

<div class="grid-container">
    {data.map((item: ServeurType) => (
        <a href={'/serveurs/' + jeu + "/" + slugify(item.name)} class="card-link">
            <GameServerVignette image={item.image} image_alt="Server Image" title={item.name} paragraph={item.description} version={item.version} jeu="minecraft" type={item.type} actif={item.is_enabled}/>
        </a>
    ))}
</div>

</Layout>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1rem 1rem 2.5rem;
        margin: 0 1rem;
    }

    @media (min-width: 950px) {
        .grid-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1500px) {
        .grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
