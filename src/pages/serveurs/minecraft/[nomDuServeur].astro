---
import {slugify} from "../../../formater/ServeurFormater";
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/sections/layout/Banner.astro";

import PlayerList from "../../../components/sections/serveurs/PlayerList.astro";
import ServeurScreen from "../../../components/sections/serveurs/ServeurScreen.astro";
import TransitionSection from "../../../components/sections/common/transitions/TransitionSection.astro";

import {ApiFetcher} from "../../../utils/API/apiFetcher";
import {PLAYERS_STATS, PLAYER_SCREENSHOTS, PB_URL, SERVERS} from "../../../utils/constantes";
import type {PlayerScreenshotType} from "../../../types/PlayerScreenshoot";
import type {ServeurType as BaseServeurType} from "../../../types/ServeurType";

// Type du serveur étendu pour la page
type ServeurType = BaseServeurType & {
    ip: string;
    screens: PlayerScreenshotType[];
};

// Le serveur est passé via getStaticPaths → props
const serveur: ServeurType | undefined = Astro.props.serveur;

export async function getScreenList(): Promise<PlayerScreenshotType[]> {
    try {
        return await ApiFetcher.pb.collection(PLAYER_SCREENSHOTS).getFullList<PlayerScreenshotType>({
            expand: 'player,discord_users,server',
            requestKey: null
        });
    } catch (error) {
        console.error("Erreur lors de la récupération des screenshots :", error);
        return [];
    }
}

// Génération des routes statiques pour chaque serveur
export async function getStaticPaths() {

    // On récupère la liste des serveurs depuis PocketBase
    const serversRaw = await ApiFetcher.getAllRecords<any>(SERVERS, { expand: 'platform' });
    
    const allStats = await ApiFetcher.getAllRecords<any>(PLAYERS_STATS);
    const screenList = await getScreenList();

    const serveurs = serversRaw.map(s => {
        const base = {
            id: s.id,
            name: s.name,
            platform: s.expand?.platform?.name?.toLowerCase() || 'minecraft',
            version: s.version,
            modpack: s.modpack,
            modpack_url: s.modpack_url,
            world_name: s.world_name,
            embed_color: s.embed_color,
            is_enabled: s.is_enabled,
            is_global: s.is_global,
            image: s.image ? `${PB_URL}/api/files/${s.collectionId}/${s.id}/${s.image}` : s.image,
            description: s.description,
            container: s.container,
            type: s.type
        };

        let ip: string;
        if (base.type === "primary") {
            ip = "antredesloutres.fr"
        } else {
            ip = "secondaire.antredesloutres.fr"
        }

        // Aggrégation playtime
        const playTimeTicks = allStats
            .filter(stat => stat.server === s.id)
            .reduce((acc, curr) => acc + (Number(curr.playtime) || 0), 0);
        const playTimeHours = Math.round(playTimeTicks / 72000);

        return {
            ...base,
            ip,
            screens: screenList.filter(screen => screen.server === s.id),
            playTimeHours,
            statutServeur: base.is_enabled ? "Le serveur est actif" : "Le serveur est désactivé"
        };
    });

    return serveurs.map((srv) => ({
        params: {
            nomDuServeur: slugify(srv.name),
        },
        props: {
            serveur: srv,
            statutServeur: srv.statutServeur,
            playTime: srv.playTimeHours,
        },
    }));
}
---
{!serveur && <h1>Serveur introuvable</h1>}
{serveur && (
<Layout title={serveur.name} ogDescription={`Description du serveur ${serveur.name}`}>
    <Banner bannerUrl={`/banner/minecraft/${slugify(serveur.name)}.webp`}/>
    <div class="profile-container">
        <TransitionSection title={`Informations du serveur #${serveur.name}#`}/>
        <div class="profile-details">
            <div class="avatar">
                <img
                    src={serveur.image}
                    alt={`Image du serveur`}
                    class="mx-auto rounded-lg object-cover h-[21em] min-h-[300px] w-auto max-w-full"
                />
            </div>

            <div class="info-grid">
                <h2>Informations</h2>
                <div class="server-card-footer">
                    <span class="server-card-badge version">Version {serveur.version}</span>
                    <span class="server-card-badge modpack"><a href={serveur.modpack_url} target="_blank" rel="noopener noreferrer">
                        {serveur.modpack}
                    </a></span>
                    <span class="server-card-badge ip">{serveur.ip}</span>
                    {serveur.is_enabled ? (
                            <span class="server-card-badge active">Activé</span>
                    ) : (
                            <span class="server-card-badge unactive">Désactivé</span>
                    )}
                </div>

                <div class="server-desc-container">
                    <p>{serveur.description}</p>
                </div>
            </div>

            <div class="info-grid">
                <h2>Action</h2>
                <div class="server-boutons-container">
                    <button class="super-button golden-outline js-copy-btn">
                        <span class="button-copy" data-ip={serveur.ip}>Copier l'IP</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="scale-up-anim     bi bi-clipboard2-fill" viewBox="0 0 16 16">
                            <path d="M9.5 0a.5.5 0 0 1 .5.5.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V2a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 5 2v-.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5.5.5 0 0 1 .5-.5z"/>
                            <path d="M3.5 1h.585A1.5 1.5 0 0 0 4 1.5V2a1.5 1.5 0 0 0 1.5 1.5h5A1.5 1.5 0 0 0 12 2v-.5q-.001-.264-.085-.5h.585A1.5 1.5 0 0 1 14 2.5v12a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-12A1.5 1.5 0 0 1 3.5 1"/>
                        </svg>
                    </button>
                    <button class="super-button golden-outline">
                        <a href={serveur.modpack_url}>Modpack</a>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="scale-up-anim bi bi-file-earmark-arrow-down-fill" viewBox="0 0 16 16">
                            <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0M9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1m-1 4v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 11.293V7.5a.5.5 0 0 1 1 0"/>
                        </svg>
                    </button>
                    <button class="super-button golden-outline">
                        <a href="/classements/minecraft/">Classement</a>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="scale-up-anim bi bi-emoji-sunglasses-fill" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16M2.31 5.243A1 1 0 0 1 3.28 4H6a1 1 0 0 1 1 1v.116A4.2 4.2 0 0 1 8 5c.35 0 .69.04 1 .116V5a1 1 0 0 1 1-1h2.72a1 1 0 0 1 .97 1.243l-.311 1.242A2 2 0 0 1 11.439 8H11a2 2 0 0 1-1.994-1.839A3 3 0 0 0 8 6c-.393 0-.74.064-1.006.161A2 2 0 0 1 5 8h-.438a2 2 0 0 1-1.94-1.515zM4.969 9.75A3.5 3.5 0 0 0 8 11.5a3.5 3.5 0 0 0 3.032-1.75.5.5 0 1 1 .866.5A4.5 4.5 0 0 1 8 12.5a4.5 4.5 0 0 1-3.898-2.25.5.5 0 0 1 .866-.5z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <TransitionSection title={`Joueurs ![https://www.minecraft.net/content/dam/minecraftnet/games/minecraft/logos/Global-Header_MCCB-Logo_300x51.svg] ayant rejoint #${serveur.name}#`}></TransitionSection>
        <PlayerList serveurId={serveur.id}/>

        <TransitionSection title={`%Screenshots% des joueurs sur le serveur #${serveur.name}#`}></TransitionSection>
        <ServeurScreen screenshots={serveur.screens}/>
    </div>

    <style>
        .profile-container {
            border-radius: 10px;
            text-align: center;
            font-family: Arial, sans-serif;
        }

        h2 {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            color: var(--h2TitleColor);
        }

        .profile-details {
            color: var(--pTextColor);
            display: grid;
            grid-template-columns: 1fr 1fr 0.6fr;
            gap: 1rem;
            align-items: flex-start;
            justify-items: center;
            padding: 2rem;
        }

        .avatar,
        .info-grid {
            width: 100%;
        }

        .avatar img {
            border-radius: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            font-size: 0.9rem;
            text-align: left;
        }

        button {
            width: 20em;
            font-size: 1em;
            justify-self: center;
            align-self: center;
        }

        @media (max-width: 990px) {
            .profile-details {
                grid-template-columns: 1fr;
            }
            .info-grid {
                text-align: center;
            }
            button {
                width: 100%;
            }
        }
    </style>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const buttons = document.querySelectorAll(".js-copy-btn");

            const checkIconPaths = `
            <path d="M6.956 1.745C7.021.81 7.908.087 8.864.325l.261.066c.463.116.874.456 1.012.965.22.816.533 2.511.062 4.51a10 10 0 0 1 .443-.051c.713-.065 1.669-.072 2.516.21.518.173.994.681 1.2 1.273.184.532.16 1.162-.234 1.733q.086.18.138.363c.077.27.113.567.113.856s-.036.586-.113.856c-.039.135-.09.273-.16.404.169.387.107.819-.003 1.148a3.2 3.2 0 0 1-.488.901c.054.152.076.312.076.465 0 .305-.089.625-.253.912C13.1 15.522 12.437 16 11.5 16H8c-.605 0-1.07-.081-1.466-.218a4.8 4.8 0 0 1-.97-.484l-.048-.03c-.504-.307-.999-.609-2.068-.722C2.682 14.464 2 13.846 2 13V9c0-.85.685-1.432 1.357-1.615.849-.232 1.574-.787 2.132-1.41.56-.627.914-1.28 1.039-1.639.199-.575.356-1.539.428-2.59z"/>
            `;

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    const span = button.querySelector(".button-copy");
                    const svg = button.querySelector("svg");
                    const ip = span.getAttribute("data-ip");

                    navigator.clipboard.writeText(ip).then(() => {
                        const originalIconContent = svg.innerHTML;

                        svg.innerHTML = checkIconPaths;

                        setTimeout(() => {
                            svg.innerHTML = originalIconContent;
                        }, 2000);
                    });
                });
            });
        });
    </script>
</Layout>
)}
