---
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import LargeTransitionSection from "../../components/sections/common/transitions/LargeTransitionSection.astro";
import type {ServeurType} from "../../types/ServeurType.ts";
import {slugify} from "../../formater/JoueurFormater.ts";
import GameServerVignette from "../../components/ui/vignettes/GameServerVignette.astro";

const apiUrl = 'https://otterlyapi.antredesloutres.fr/api/serveurs/actif-global/palworld';
const jeu = 'palworld';

// Récupération des données depuis l'API
let data
if (apiUrl) {
    const res = await fetch(apiUrl);
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
        data = json.data;
    }
}
---

<Layout>

<Banner bannerUrl="https://image.api.playstation.com/vulcan/ap/rnd/202405/2108/d976f5d6313a7174e5341d3a5e3f21559f56f86f40a71d2f.png"/>

<LargeTransitionSection title="%Nos serveurs% #Palworld#" invertedBackground/>

<div class="grid-container">
    {data.map((item: ServeurType) => (
            <a href={'/serveurs/' + jeu + "/" + slugify(item.nom)} class="card-link">
                <GameServerVignette image={item.image} image_alt="Server Image" title={item.nom} paragraph={item.description} version={item.version} jeu={item.jeu} type={item.type}/>
            </a>
    ))}
</div>

</Layout>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1rem 1rem 2.5rem;
        margin: 0 1rem;
    }

    @media (min-width: 950px) {
        .grid-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1500px) {
        .grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
