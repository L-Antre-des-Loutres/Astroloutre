---
import Layout from '../layouts/Layout.astro';

import Welcome from '../components/Welcome.astro';
import LargeBanner from "../components/transitions/LargeBanner.astro";
import QuiSommesNous from "../components/home/QuiSommesNous.astro";
import BotsDescription from "../components/home/BotsDescription.astro";
import MobileNav from "../components/home/MobileNav.astro";

import {formatMinecraftPlayTime} from "../formater/MinecraftPlayTimeFormater.ts";
import {formatDecimalHours} from "../formater/DecimalHoursFormater.ts";
import DefaultBanner from "../components/transitions/DefaultBanner.astro";

// Total of player playtime
let totalHours: Promise<number> | number = 0;

// Minecraft playtime
const response = await fetch('https://otterlyapi.antredesloutres.fr/api/joueurs/stats-serveur/serveurs-total-playtime');
if (response.ok) {
    const json = await response.json();
    totalHours = formatMinecraftPlayTime(Number(json?.data?.[0]?.total_hours || 0));
}

// Palworld playtime
const responsePalworld = await fetch('https://otterlyapi.antredesloutres.fr/api/palworld/stats/total-hours');
if (responsePalworld.ok) {
    const json = await responsePalworld.json();
    totalHours += await formatDecimalHours(json?.data?.[0]?.total_hours) || 0;
}
---

<Layout>
	<Welcome />

    <LargeBanner title="Un total de plus de #${totalHours} heures# joué sur nos ![serveurs.webp] !"/>

	<QuiSommesNous/>
    <MobileNav/>

    <DefaultBanner title="Des ![bots.webp] codés par nos soins ![nos-soins.webp] !"/>

	<BotsDescription
		imageSrc="https://github.com/L-Antre-des-Loutres/Arisoutre/blob/main/arisoutre-logo.png?raw=true"
		imageAlt="Logo Arisoutre"
		title="Arisoutre, elle c'est la patronne"
		link="https://github.com/L-Antre-des-Loutres/Arisoutre"
		paragraph="Arisoutre gère tout ce qui est récupération des données Discord, ainsi que la modération. C'est aussi elle qui dit bienvenue lorsqu'il y a des nouveaux !"
	/>
	<BotsDescription
		imageSrc="https://github.com/Corentin-cott/Mineotter-Bot/blob/main/imgs/logo-text.png?raw=true"
		imageAlt="Logo Mineotter"
		title="Mineotter, le bots de nos serveurs Minecraft"
		link="https://github.com/Corentin-cott/Mineotter-Bot"
		paragraph="Mineotter, c'est le bot qui gère les serveurs Minecraft, que ce soit le chat lié, l'ouverture des serveurs et leur fermeture. C'est elle qui gère ça !"
	/>
	<BotsDescription
		imageSrc="https://github.com/L-Antre-des-Loutres/MultiLoutre/blob/main/multiloutre-logo.png?raw=true"
		imageAlt="Logo Multiloutre"
		title="Multiloutre, le bots de tous nos autres serveurs"
		link="https://github.com/L-Antre-des-Loutres/MultiLoutre"
		paragraph="Multiloutre, c'est le bot qui gère les serveurs autres que Minecraft, que ce soit le chat lié, l'ouverture des serveurs et leur fermeture. C'est lui qui gère ça !"
	/>
	<BotsDescription
		imageSrc="https://images-ext-1.discordapp.net/external/UOv-DRMsbOfJ8iGiHnCm4Ntsr0aXveza_lfPH_T1yc4/https/raw.githubusercontent.com/L-Antre-des-Loutres/Mateloutre/refs/heads/main/imgs/MateloutreLogo1.png?format=webp&quality=lossless"
		imageAlt="Logo Mateloutre"
		title="Mateloutre, la peluche de notre catégorie Pokémon"
		link="https://github.com/L-Antre-des-Loutres/Mateloutre"
		paragraph="Mateloutre, c'est le petit nouveau de la bande, pour l'instant il affiche les news récentes de Pokémon mais il fera bientôt d'autres trucs !"
	/>
	<BotsDescription
		imageSrc="https://raw.githubusercontent.com/matheo-1712/Citlali/refs/heads/main/logo.png"
		imageAlt="Logo Citlaloutre"
		title="Citlaloutre, Elle qui n'est pas une loutre"
		link="https://github.com/matheo-1712/Citlali"
		paragraph="Citlaloutre (Citlali) et le bot Genshin de l'Antre des Loutres, il permet d'afficher les builds des personnages demandés"
	/>
</Layout>
