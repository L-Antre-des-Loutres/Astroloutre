---
// Layout import
import Layout from "../layouts/Layout.astro";
// Components import
import Carrousel from "../components/sections/home/Carrousel.astro";
import LargeTransitionSection from "../components/sections/common/transitions/LargeTransitionSection.astro";
import PresentationSection from "../components/sections/home/PresentationSection.astro";
import MobileNav from "../components/sections/home/MobileNav.astro";
import TransitionSection from "../components/sections/common/transitions/TransitionSection.astro";
import SlidingVignette from "../components/ui/vignettes/SlidingVignette.astro";
// Other imports
import {formatMinecraftPlayTime} from "../formater/MinecraftPlayTimeFormater.ts";
import {ApiFetcher} from "../utils/API/apiFetcher";
import {PLAYERS_STATS} from "../utils/constantes";

// Declaration of total playtime variable
let totalHours: number = 0;

// Minecraft playtime from PocketBase
const mcStats = await ApiFetcher.getAllRecords<any>(PLAYERS_STATS);
const totalTicksMinecraft = mcStats.reduce((acc, curr) => acc + (Number(curr.playtime) || 0), 0);
totalHours = formatMinecraftPlayTime(totalTicksMinecraft);
---

<Layout>
    <Carrousel/>

    <LargeTransitionSection
            title={`Un total de plus de #_${totalHours} heures_# jouées sur nos %serveurs% !`}
    />

    <PresentationSection/>

    <MobileNav/>

    <TransitionSection title="Des #bots# codés par %nos soins% !"/>

    <div class="sliding-cards-container">
        <SlidingVignette
                image="https://raw.githubusercontent.com/L-Antre-des-Loutres/Arisoutre/main/src/app/assets/images/arisoutre-logo.png"
            image_alt="Logo Arisoutre"
            title="#Arisoutre#, elle c'est la #patronne#"
            paragraph="Arisoutre gère tout ce qui est récupération des données Discord, ainsi que la modération. C'est aussi elle qui dit bienvenue lorsqu'il y a des nouveaux !"
            card_link="https://github.com/L-Antre-des-Loutres/Arisoutre"
        />
        <SlidingVignette
                image="https://raw.githubusercontent.com/Corentin-cott/Mineotter/refs/heads/main/src/app/imgs/logo-text.png"
            image_alt="Logo Mineotter"
            title="#Mineotter#, le bot de nos #serveurs Minecraft#"
            paragraph="Mineotter, c'est le bot qui gère les serveurs Minecraft, que ce soit le chat lié, l'ouverture des serveurs et leur fermeture. C'est elle qui gère ça !"
            card_link="https://github.com/Corentin-cott/Mineotter"
        />
        <SlidingVignette
                image="https://raw.githubusercontent.com/L-Antre-des-Loutres/Multiloutre/refs/heads/main/multiloutre-logo.png"
            image_alt="Logo Multiloutre"
            title="#Multiloutre#, le bot de tous #nos autres serveurs#"
            paragraph="Multiloutre, c'est le bot qui gère les serveurs autres que Minecraft, que ce soit le chat lié, l'ouverture des serveurs et leur fermeture. C'est lui qui gère ça !"
            card_link="https://github.com/L-Antre-des-Loutres/MultiLoutre"
        />
        <SlidingVignette
                image="/icons/logo_mateloutre.png"
            image_alt="Logo Mateloutre"
            title="#Mateloutre#, la peluche de notre #catégorie Pokémon#"
            paragraph="Mateloutre, c'est le petit nouveau de la bande, pour l'instant il affiche les news récentes de Pokémon mais il fera bientôt d'autres trucs !"
                card_link="https://github.com/L-Antre-des-Loutres/Matloutre"
        />
        <SlidingVignette
            image="https://raw.githubusercontent.com/matheo-1712/Citlali/refs/heads/main/logo.png"
            image_alt="Logo Citlali"
            title="#Citlaloutre#, celle qui n'est pas vraiment une #loutre#"
            paragraph="Citlaloutre (Citlali de son vrai nom) est le bot Genshin de l'Antre des Loutres, il permet d'afficher les builds des personnages demandés"
            card_link="https://github.com/matheo-1712/Citlali"
        />
    </div>
</Layout>
