<script>
    import {getOapiSession, refreshOapiBadges} from "../../utils/API/oapiAuth.ts";

    const REFRESH_MESSAGES: Record<number, string> = {
        401: "Session expirée : reconnecte-toi pour rafraîchir tes badges.",
        429: "Trop de demandes, réessaie dans quelques instants.",
    };

    async function refreshBadges(button: HTMLButtonElement) {
        const label = document.getElementById('badges-refresh-label');
        const message = document.getElementById('badges-refresh-message');

        button.disabled = true;
        button.classList.add('is-loading');
        if (label) label.textContent = 'Rafraîchissement...';
        if (message) message.hidden = true;

        const status = await refreshOapiBadges();

        button.disabled = false;
        button.classList.remove('is-loading');
        if (label) label.textContent = 'Rafraîchir mes badges';
        if (!message) return;

        const success = status !== null && status >= 200 && status < 300;
        // Le site est statique : les nouveaux badges s'afficheront à la prochaine génération
        message.textContent = success
            ? "Badges rafraîchis ! Ils apparaîtront à la prochaine mise à jour du site."
            : (status !== null && REFRESH_MESSAGES[status]) || "Impossible de rafraîchir les badges pour le moment.";
        message.classList.toggle('active', success);
        message.classList.toggle('unactive', !success);
        message.hidden = false;
    }

    // Bouton "Rafraîchir" des badges : affiché seulement si on consulte son propre profil
    async function showBadgesRefresh() {
        const container = document.getElementById('badges-refresh');
        const profileDiscordId = container?.dataset.discordId;
        if (!container || !profileDiscordId) return;

        const session = await getOapiSession();
        if (!session?.authenticated || session.discord_id !== profileDiscordId) return;

        container.hidden = false;
        const button = document.getElementById('badges-refresh-button') as HTMLButtonElement | null;
        button?.addEventListener('click', () => refreshBadges(button));
    }
    showBadgesRefresh();
</script>

<script>
    import {getOapiSession} from "../../utils/API/oapiAuth.ts";
    import {acceptFriend, getFriends, OapiFriendsError, removeFriend, requestFriendByTag} from "../../utils/API/oapiFriends.ts";
    import type {Friendship} from "../../utils/API/oapiFriends.ts";

    type FriendState = "none" | "outgoing" | "incoming" | "friends";

    const container = document.getElementById('friend-action');
    const button = document.getElementById('friend-action-button') as HTMLButtonElement | null;
    const label = document.getElementById('friend-action-label');
    const cancel = document.getElementById('friend-action-cancel') as HTMLButtonElement | null;
    const friendsLink = document.getElementById('friend-action-link');
    const message = document.getElementById('friend-action-message');

    // Membre OAPI correspondant au profil, connu une fois qu'une demande existe dans un sens ou dans l'autre
    let entry: Friendship | undefined;
    let state: FriendState = "none";

    function showMessage(text: string, success: boolean) {
        if (!message) return;
        message.textContent = text;
        message.classList.toggle('active', success);
        message.classList.toggle('unactive', !success);
        message.hidden = false;
    }

    function render() {
        if (!button || !label || !cancel || !friendsLink) return;
        button.hidden = state === "friends";
        button.disabled = state === "outgoing";
        label.textContent = state === "incoming" ? "Accepter sa demande d'ami"
            : state === "outgoing" ? "Demande envoyée" : "Ajouter en ami";
        cancel.hidden = state !== "outgoing";
        friendsLink.hidden = state !== "friends";
    }

    async function loadState(discordId: string) {
        const list = await getFriends();
        const match = (kind: "friends" | "incoming" | "outgoing") => list[kind].find((item) => item.user.discord_id === discordId);
        entry = match("friends") ?? match("incoming") ?? match("outgoing");
        state = match("friends") ? "friends" : match("incoming") ? "incoming" : match("outgoing") ? "outgoing" : "none";
    }

    async function run(work: () => Promise<string>, discordId: string) {
        if (!button || !cancel) return;
        button.disabled = cancel.disabled = true;
        if (message) message.hidden = true;
        try {
            const success = await work();
            await loadState(discordId);
            showMessage(success, true);
        } catch (error) {
            showMessage(error instanceof OapiFriendsError ? error.message : "Impossible de joindre OAPI pour le moment.", false);
            if (error instanceof OapiFriendsError && error.status === 401) container?.setAttribute('hidden', '');
        } finally {
            cancel.disabled = false;
            render();
        }
    }

    async function showFriendAction() {
        const discordId = container?.dataset.discordId;
        const discordTag = container?.dataset.discordTag;
        // Sans tag Discord, OAPI ne peut pas recevoir de demande pour ce membre
        if (!container || !button || !cancel || !discordId || !discordTag) return;

        const session = await getOapiSession();
        if (!session?.authenticated || session.discord_id === discordId) return;

        try {
            await loadState(discordId);
        } catch (error) {
            // OAPI indisponible ou session expirée : on n'affiche pas un bouton qui ne marcherait pas
            console.error("OAPI: impossible de charger les amis:", error);
            return;
        }
        render();
        container.hidden = false;

        button.addEventListener('click', () => run(async () => {
            if (state === "incoming" && entry) {
                await acceptFriend(entry.user.id);
                return "Demande acceptée : vous êtes maintenant amis !";
            }
            const result = await requestFriendByTag(discordTag);
            return result.status === "accepted"
                ? "Ce membre t'avait déjà envoyé une demande : vous êtes maintenant amis !"
                : "Demande d'ami envoyée !";
        }, discordId));

        cancel.addEventListener('click', () => run(async () => {
            if (entry) await removeFriend(entry.user.id);
            return "Ta demande a été annulée.";
        }, discordId));
    }
    showFriendAction();
</script>

