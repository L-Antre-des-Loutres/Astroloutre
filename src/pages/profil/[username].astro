---
import {Image} from 'astro:assets';
import {isSteamPlayer, isMinecraftPlayer, playerHeadUrl, playerPageHref, slugify} from "../../formater/JoueurFormater";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import {formatDate} from "../../formater/DateFormater";
import BadgeList from "../../components/sections/badges/BadgeList.astro";
import {vocalTimeFormater} from "../../formater/VocalTimeFormater";
import TransitionSection from "../../components/sections/common/transitions/TransitionSection.astro";
import UserScreenshots from "../../components/sections/profil/UserScreenshots.astro";
import type {LinkAccount, DiscordUserType, DiscordUserStatsType, Roles} from "../../types/UtilisateurDiscordType.ts";
import {ApiFetcher} from "../../utils/API/apiFetcher";
import {DISCORD_USER_STATS, DISCORD_USERS, PLAYER_SCREENSHOTS, POKEDEVINER_STATS, POKE_SILHOUETTE_SCORES} from "../../utils/constantes.ts";
import type {PlayerScreenshotType} from "../../types/PlayerScreenshoot";
import type {PokedevinerStatType} from "../../types/PokedevinerStatsType.ts";
import PokedevinerStatsList from "../../components/sections/profil/PokedevinerStatsList.astro";
import type {PokeSilhouetteScoreType} from "../../types/PokeSilhouetteStatsType.ts";
import PokeSilhouetteStatsList from "../../components/sections/profil/PokeSilhouetteStatsList.astro";
import DiscordActivityStats from "../../components/sections/profil/DiscordActivityStats.astro";
import {OapiFetcher} from "../../utils/API/oapiFetcher";
import type {ActivityDay, DiscordActivityType} from "../../types/DiscordActivityType.ts";

// Props passées depuis getStaticPaths
const utilisateur: DiscordUserType | undefined = Astro.props.joueur;
const allRelatedPbIds: string[] = Astro.props.allRelatedPbIds || [];
const userScreenshots: PlayerScreenshotType[] = Astro.props.userScreenshots || [];
const pokedevinerStats: PokedevinerStatType[] = Astro.props.pokedevinerStats || [];
const pokeSilhouetteStats: PokeSilhouetteScoreType[] = Astro.props.pokeSilhouetteStats || [];
// Returns LinkAccount[] instead of single object
const accountLinks: LinkAccount[] = Astro.props.accountLinks || [];
const discordActivity: DiscordActivityType | null = Astro.props.discordActivity ?? null;
const companionHref: string | null = Astro.props.companionHref ?? null;
const stats: (DiscordUserType & { message_count: number, vocal_time: number, stats: DiscordUserStatsType[] }) | undefined = Astro.props.stats;
/**
 * Génère les pages statiques
 */
export async function getStaticPaths() {

    // ──────────────────────────────────────────────
    // Récupération des informations
    // ──────────────────────────────────────────────

    const joueurs = await ApiFetcher.getAllRecords<DiscordUserType>(DISCORD_USERS);
    const stats = await ApiFetcher.getAllRecords<DiscordUserStatsType>(DISCORD_USER_STATS);
    // La plateforme (expand) sert à choisir le lien et l'avatar de chaque compte lié
    const accountsLinks = await ApiFetcher.getAllRecords<LinkAccount>("players", {expand: 'platform'});
    const allScreenshots = await ApiFetcher.getAllRecords<PlayerScreenshotType>(PLAYER_SCREENSHOTS, {
        expand: 'server,server.platform,platform'
    });
    const allPokedevinerStats = await ApiFetcher.getAllRecords<PokedevinerStatType>(POKEDEVINER_STATS, {
        fields: "discord_user,created,success_at,nb_try,pokemon_name,pokemon_try_list,is_expired",
        sort: "-created"
    });
    const allPokeSilhouetteScores = await ApiFetcher.getAllRecords<PokeSilhouetteScoreType>(POKE_SILHOUETTE_SCORES, {
        expand: "game"
    });
    const discordStats = await OapiFetcher.getDiscordStats();

    // Record vocal recalculé sans les journées de plus de 24h (données erronées côté bot)
    const plausibleVocalRecord = (daily: ActivityDay[] = []): ActivityDay | null =>
        daily
            .filter((day) => day.vocal_hours > 0 && day.vocal_hours <= 24)
            // À égalité, la date la plus ancienne l'emporte (même règle qu'OAPI, daily est trié par date)
            .reduce<ActivityDay | null>((best, day) => (!best || day.vocal_hours > best.vocal_hours ? day : best), null);
    // ──────────────────────────────────────────────
    // Regroupement par Discord ID pour gérer les doublons
    // ──────────────────────────────────────────────

    // Map pour stocker les joueurs uniques par leur discord_id
    const playersByDiscordId = new Map<string, DiscordUserType>();
    // Map pour regrouper tous les PB IDs associés à un discord_id
    const pbIdsByDiscordId = new Map<string, string[]>();

    // On trie par last_active_at pour avoir les records les plus récents en premier
    const sortedJoueurs = [...joueurs].sort((a, b) => {
        const dateA = a.last_active_at ? new Date(a.last_active_at).getTime() : 0;
        const dateB = b.last_active_at ? new Date(b.last_active_at).getTime() : 0;
        return dateB - dateA;
    });

    sortedJoueurs.forEach(joueur => {
        if (!playersByDiscordId.has(joueur.discord_id)) {
            playersByDiscordId.set(joueur.discord_id, joueur);
        }
        const ids = pbIdsByDiscordId.get(joueur.discord_id) || [];
        ids.push(joueur.id);
        pbIdsByDiscordId.set(joueur.discord_id, ids);
    });

    // Lien de profil par ID Discord, ID PocketBase ou tag (pour le compagnon vocal)
    const profileHrefByRef = new Map<string, string>();
    joueurs.forEach((joueur) => {
        const profil = playersByDiscordId.get(joueur.discord_id);
        const tag = profil?.discord_tag;
        // Même filtre que les pages générées : pas de lien vers un profil inexistant
        if (!tag || typeof profil.username !== 'string' || profil.username.trim() === '') return;
        const href = `/profil/${slugify(tag)}/`;
        [joueur.id, joueur.discord_id, tag].forEach((ref) => ref && profileHrefByRef.set(ref, href));
    });

    // ──────────────────────────────────────────────
    // Renvoie des informations
    // ──────────────────────────────────────────────
    return Array.from(playersByDiscordId.values())
        .filter((joueur) => typeof joueur.username === 'string' && joueur.username.trim() !== '')
        .map((joueur) => {
            const allRelatedPbIds = pbIdsByDiscordId.get(joueur.discord_id) || [joueur.id];

            // Retrieve ALL linked accounts for all PB IDs of this user
            const accountLinks = accountsLinks.filter(
                (link) => allRelatedPbIds.includes(link.discord_user)
            );

            // Retrieve ALL stats for all PB IDs of this user
            const userStatsHistory = stats.filter(
                (stat) => allRelatedPbIds.includes(stat.discord_user)
            );

            // Retrieve ALL screenshots for all PB IDs of this user
            const userScreenshots = allScreenshots.filter(
                (screen) => allRelatedPbIds.includes(screen.discord_users)
            );
            const pokedevinerStats = allPokedevinerStats.filter(
                (stat) => allRelatedPbIds.includes(stat.discord_user)
            );
            const pokeSilhouetteStats = allPokeSilhouetteScores
                .filter((stat) => allRelatedPbIds.includes(stat.discord_user))
                .sort((a, b) => {
                    const dateA = a.expand?.game?.started_at ? new Date(a.expand.game.started_at).getTime() : 0;
                    const dateB = b.expand?.game?.started_at ? new Date(b.expand.game.started_at).getTime() : 0;
                    return dateB - dateA;
                });

            // Statistiques détaillées OAPI (salons préférés, records, compagnon vocal)
            const playerActivity = discordStats?.players.find(
                (player) => player.discord_id === joueur.discord_id || allRelatedPbIds.includes(player.id)
            );
            // L'historique journalier n'est pas affiché : on ne le transmet pas à la page
            const discordActivity = playerActivity ? {
                ...playerActivity.stats,
                record_vocal_day: plausibleVocalRecord(playerActivity.stats.daily),
                daily: [],
            } : null;
            const companion = discordActivity?.top_voice_companion;
            const companionHref = companion
                ? profileHrefByRef.get(companion.id) ?? profileHrefByRef.get(companion.username) ?? null
                : null;

            // Aggregate stats
            const totalMessages = userStatsHistory.reduce((acc, curr) => acc + (Number(curr.message_count) || 0), 0);
            const totalVocalTime = userStatsHistory.reduce((acc, curr) => acc + (Number(curr.vocal_time) || 0), 0);

            // Combine into global stats object
            const globalStats = {
                ...joueur,
                message_count: totalMessages,
                vocal_time: totalVocalTime,
                stats: userStatsHistory
            };

            return {
                params: {
                    username: slugify(joueur.discord_tag),
                },
                props: {
                    joueur,
                    allRelatedPbIds,
                    userScreenshots,
                    pokedevinerStats,
                    pokeSilhouetteStats,
                    accountLinks: accountLinks, // Returns array, empty if none
                    stats: globalStats, // Pass combined stats
                    discordActivity,
                    companionHref,
                },
            };
        });

}

const voyelles = ['a', 'e', 'i', 'o', 'u', 'y', 'h'];
let prefixe = "de ";

if (utilisateur && utilisateur.username && voyelles.includes(utilisateur.username[0].toLowerCase())) {
    prefixe = "d’";
}

// Vérifie le nombre de message des joueurs
let messageFormat = " message"
const msgCount = stats?.message_count ??  0;

if (msgCount > 1) {
    messageFormat = " messages"
}
---
{!utilisateur && <h1>Joueur introuvable</h1>}
{utilisateur && (
<Layout ogImage={utilisateur?.avatar_url} title={`${utilisateur?.username}`}
        ogDescription={`Profil Discord : ${utilisateur?.username}`}>
    <Banner/>

    <div class="profile-container">
        <TransitionSection title={`Profil #Discord# ${prefixe}#${utilisateur.username}#`}/>

        <div class="profile-details">

            {/* Colonne 1 : Avatar */}
            <div class="avatar">
                <Image
                        src={utilisateur.avatar_url}
                        alt={`Avatar de ${utilisateur.username}`}
                        class="mx-auto rounded-lg object-cover h-[21em] min-h-[300px] w-auto max-w-full"
                        width={300}
                        height={300}
                        loading="eager"
                />
            </div>

            {/* Colonne 2 : Informations */}
            <div class="info-grid">
                <h2>Informations</h2>

                {/* Badges style */}
                <div class="server-card-footer">
                    <span class="server-card-badge version">{utilisateur.discord_tag}</span>
                    {utilisateur.roles?.map((role: Roles) => {
                        const isFounder = role.id === "1112707976273338470";
                        const isInvesti = role.id === "1113865928086655037";

                        let badgeClass = "server-card-badge modpack";
                        if (isFounder) badgeClass += " founder-role-badge";
                        else if (isInvesti) badgeClass += " special-role-badge";

                        return (
                                <span
                                        class={badgeClass}
                                        style={(isFounder || isInvesti) ? `--role-color: ${role.color};` : ''}
                                >
                                {role.name.replace(/\p{Extended_Pictographic}/gu, '').trim()}
                            </span>
                        )
                    })}
                </div>

                {/* Visible uniquement quand on consulte le profil d'un autre membre en étant connecté (voir script) */}
                <div id="friend-action" class="friend-action" data-discord-id={utilisateur.discord_id}
                     data-discord-tag={utilisateur.discord_tag} hidden>
                    <button id="friend-action-button" type="button" class="super-button golden-outline friend-action-button">
                        <svg class="friend-action-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                        <span id="friend-action-label">Ajouter en ami</span>
                    </button>
                    <button id="friend-action-cancel" type="button" class="friend-action-cancel" hidden>Annuler la demande</button>
                    <a id="friend-action-link" class="server-card-badge active friend-action-link" href="/amis" hidden>✓ Vous êtes amis</a>
                    <p id="friend-action-message" class="server-card-badge friend-action-message" aria-live="polite" hidden></p>
                </div>

                <div class="server-desc-container">
                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                            </svg>
                            Messages :
                        </strong>
                        <span>{stats?.message_count} {messageFormat}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                            </svg>
                            Temps Vocal :
                        </strong>
                        <span>{vocalTimeFormater(stats?.vocal_time || 0)}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Activité récente :
                        </strong>
                        <span>{formatDate(utilisateur.last_active_at)}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            {/* J'ai changé l'icône et le texte pour correspondre à "Date d'arrivée" */}
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Date d'arrivée :
                        </strong>
                        <span>{formatDate(utilisateur.joined_at)}</span>
                    </div>
                </div>
            </div>

            {/* Colonne 3 : Actions / Comptes Liés */}
            <div class="info-grid">
                <h2>Comptes Liés</h2>
                <div class="server-boutons-container"
                     style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    {accountLinks.length > 0 ? (
                        accountLinks.map(account => isSteamPlayer(account) || isMinecraftPlayer(account) ? (
                                <a href={playerPageHref(account)} class="w-full">
                                <button class="super-button golden-outline w-full" style="border-radius: 5px">
                                    <span style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                                        <Image src={isSteamPlayer(account) && account.avatar_url ? account.avatar_url : playerHeadUrl(account, 32)} alt="Head"
                                               width={24} height={24} class="rounded-sm"/>
                                        {account.playername}
                                        {isSteamPlayer(account) && (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-label="Compte Steam" role="img">
                                                <title>Compte Steam</title>
                                                <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658a3.387 3.387 0 0 1 1.912-.59c.064 0 .127.003.19.006l2.862-4.142V8.91a4.528 4.528 0 0 1 4.524-4.524 4.528 4.528 0 0 1 4.523 4.524 4.528 4.528 0 0 1-4.523 4.524h-.105l-4.076 2.911c0 .052.004.105.004.159a3.392 3.392 0 0 1-3.39 3.393 3.406 3.406 0 0 1-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25a2.551 2.551 0 0 0 3.337-3.334 2.547 2.547 0 0 0-3.255-1.379l1.523.63a1.878 1.878 0 0 1-1.446 3.443zm11.415-9.303a3.019 3.019 0 0 0-3.015-3.015 3.015 3.015 0 1 0 3.015 3.015zm-5.273-.005a2.264 2.264 0 1 1 4.531 0 2.267 2.267 0 0 1-2.266 2.265 2.264 2.264 0 0 1-2.265-2.265z"/>
                                            </svg>
                                        )}
                                    </span>
                                </button>
                            </a>
                        ) : (
                            // Pas encore de page joueur pour les autres plateformes : compte affiché sans lien
                            <div class="server-card-badge" style="width: 100%; text-align: center;">
                                {account.playername} ({account.expand?.platform?.name ?? "Plateforme inconnue"})
                            </div>
                        ))
                    ) : (
                            <div class="server-card-badge unactive" style="width: 100%; text-align: center;">Aucun
                                compte lié
                            </div>
                    )}
                </div>

                <div class="server-boutons-container">
                    <!--
                    <form id="link-account-form" data-user-id={utilisateur.id} class="w-full form-inline" style="display: flex; flex-direction: row; gap: 0.5rem; width: 100%;">
                        <input
                                type="text"
                                name="code"
                                placeholder="Code de liaison"
                                class="code-input"
                                required
                                style="flex: 1; padding: 0.5rem; border-radius: 5px; border: 2px solid #ccc;"
                        />
                        <button type="submit" class="super-button golden-outline" style="white-space: nowrap; width: auto; border-radius: 5px">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="scale-up-anim bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z"/>
                            </svg>
                        </button>
                    </form>
                         -->
                </div>
            </div>
        </div>

        <DiscordActivityStats activity={discordActivity} companionHref={companionHref} />

        <TransitionSection title={`%Badges% de l'utilisateur #${utilisateur.username}#`}/>
        {/* Visible uniquement par le propriétaire du profil une fois connecté (voir script) */}
        <div id="badges-refresh" class="badges-refresh" data-discord-id={utilisateur.discord_id} hidden>
            <button id="badges-refresh-button" type="button" class="super-button golden-outline badges-refresh-button"
                    title="Recalculer mes badges">
                <svg class="badges-refresh-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span id="badges-refresh-label">Rafraîchir mes badges</span>
            </button>
            <p id="badges-refresh-message" class="server-card-badge badges-refresh-message" aria-live="polite" hidden></p>
        </div>
        <BadgeList PlayerOrUser="User" userId={utilisateur.id} categoryId={1} allRelatedPbIds={allRelatedPbIds} />

        <TransitionSection title={`%Screenshots% de l'utilisateur #${utilisateur.username}#`}/>
        <UserScreenshots screenshots={userScreenshots} />

        <TransitionSection title={`%Statistique% sur #Pokedeviner#`}/>
        <PokedevinerStatsList stats={pokedevinerStats} />

        <TransitionSection title={`%Statistique% sur #Poke-Silhouette#`}/>
        <PokeSilhouetteStatsList scores={pokeSilhouetteStats} />
    </div>

    <style>
        .profile-container {
            border-radius: 10px;
            text-align: center;
            font-family: Arial, sans-serif;
        }

        h2 {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            color: var(--h2TitleColor);
        }

        .profile-details {
            color: var(--pTextColor);
            display: grid;
            grid-template-columns: 0.6fr 1fr 0.6fr;
            gap: 1rem;
            align-items: flex-start;
            justify-items: center;
            padding: 2rem;
        }

        .avatar,
        .info-grid {
            width: 100%;
        }

        .avatar img {
            border-radius: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            font-size: 0.9rem;
            text-align: left;
        }

        .server-desc-container {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Crée 2 colonnes de largeur égale */
            gap: 1rem; /* Espace entre les cellules */
            width: 100%;
        }

        .stats-row {
            display: flex;
            flex-direction: column;
            background-color: rgba(0, 0, 0, 0.03); /* Petit fond gris optionnel pour bien voir la grille */
            padding: 0.8rem;
            border-radius: 8px;
            text-align: left; /* Ou center selon votre préférence */
        }

        /* Optionnel : Passer à 1 colonne sur mobile */
        @media (max-width: 600px) {
            .server-desc-container {
                grid-template-columns: 1fr;
            }
        }

        .stats-row {
            display: flex;
            flex-direction: column;
        }

        .icon {
            display: inline;
            vertical-align: text-bottom;
            margin-right: 6px;
            color: var(--h2TitleColor); /* Utilisation de la variable globale ou fallback */
        }


        .friend-action {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem;
            margin: 0.75rem 0;
        }

        .friend-action[hidden],
        .friend-action [hidden] {
            display: none;
        }

        /* Même version compacte du super-button que "Rafraîchir mes badges" */
        .friend-action .friend-action-button {
            gap: 8px;
            padding: 8px 18px;
            font-size: 0.85rem;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .friend-action .friend-action-button:hover:not(:disabled) {
            transform: translateY(-1px);
        }

        .friend-action .friend-action-button:disabled {
            opacity: 0.7;
            cursor: default;
        }

        .friend-action .friend-action-icon {
            width: 16px;
            height: 16px;
        }

        .friend-action-cancel {
            font-size: 0.85rem;
            text-decoration: underline;
            opacity: 0.8;
            cursor: pointer;
        }

        .friend-action-cancel:hover:not(:disabled) {
            opacity: 1;
        }

        .friend-action-link {
            text-decoration: none;
        }

        .badges-refresh {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin: 1.25rem 1rem 0.5rem;
        }

        .badges-refresh[hidden],
        .badges-refresh-message[hidden] {
            display: none;
        }

        /* Version compacte du super-button : action secondaire au-dessus de la galerie */
        .badges-refresh .badges-refresh-button {
            gap: 8px;
            padding: 8px 18px;
            font-size: 0.85rem;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .badges-refresh .badges-refresh-button:hover:not(:disabled) {
