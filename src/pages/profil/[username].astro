---
import {Image} from 'astro:assets';
import {slugify} from "../../formater/JoueurFormater";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import {formatDate} from "../../formater/DateFormater";
import BadgeList from "../../components/sections/badges/BadgeList.astro";
import {vocalTimeFormater} from "../../formater/VocalTimeFormater";
import TransitionSection from "../../components/sections/common/transitions/TransitionSection.astro";
import type {LinkAccount, DiscordUserType, DiscordUserStatsType, Roles} from "../../types/UtilisateurDiscordType.ts";

// Props passées depuis getStaticPaths
const utilisateur: DiscordUserType | undefined = Astro.props.joueur;
// Returns LinkAccount[] instead of single object
const accountLinks: LinkAccount[] = Astro.props.accountLinks || [];
// Stats for this user
const stats: (DiscordUserType & { stats: DiscordUserStatsType[] }) | undefined = Astro.props.stats;

// Génération des pages statiques
export async function getStaticPaths() {

    // Récupération des informations des utilisateurs discord
    const apiUrl = 'https://otterlyapi.antredesloutres.fr/api/utilisateurs_discord/';
    const response = await fetch(apiUrl);
    if (!response.ok) {
        throw new Error(`Erreur API joueurs: ${response.status}`);
    }
    const json = await response.json();
    if (!json.success || !Array.isArray(json.data)) return [];
    const joueurs: DiscordUserType[] = json.data;

    // Récupération des statistiques des utilisateurs
    const reponseStats = await fetch("https://otterlyapi.antredesloutres.fr/api/utilisateurs_discord/stats")
    if (!reponseStats.ok) {
        throw new Error(`Erreur API Stats : ${reponseStats.status}`)
    }
    const jsonStats = await reponseStats.json()
    if (!jsonStats.success || !Array.isArray(jsonStats.data)) return [];
    const stats: DiscordUserStatsType[] = jsonStats.data;

    // Récupération des informations des comptes liées
    const reponseAccountLink = await fetch("https://otterlyapi.antredesloutres.fr/api/joueurs")
    if (!reponseAccountLink.ok){
        throw new Error(`Erreur API Link account : ${reponseAccountLink.status}`)
    }
    const jsonAccountLink = await reponseAccountLink.json()
    if (!json.success || !Array.isArray(json.data)) return [];
    const accountsLinks: LinkAccount[] = jsonAccountLink.data;

    return joueurs
        .filter((joueur) => typeof joueur.pseudo_discord === 'string' && joueur.pseudo_discord.trim() !== '')
        .map((joueur) => {
            // Retrieve ALL linked accounts
            const accountLinks = accountsLinks.filter(
                (link) => link.utilisateur_id === joueur.id
            );

            // Retrieve ALL stats for this user
            const userStatsHistory = stats.filter(
                (stat) => stat.id_utilisateur === joueur.id
            );

            // Aggregate stats
            const totalMessages = userStatsHistory.reduce((acc, curr) => acc + (Number(curr.nb_message) || 0), 0);
            const totalVocalTime = userStatsHistory.reduce((acc, curr) => acc + (Number(curr.vocal_time) || 0), 0);

            // Combine into global stats object
            const globalStats = {
                ...joueur,
                nb_message: totalMessages,
                vocal_time: totalVocalTime,
                stats: userStatsHistory
            };

            return {
                params: {
                    username: slugify(joueur.tag_discord),
                },
                props: {
                    joueur,
                    accountLinks: accountLinks, // Returns array, empty if none
                    stats: globalStats, // Pass combined stats
                },
            };
        });

}

const voyelles = ['a', 'e', 'i', 'o', 'u', 'y', 'h'];
let prefixe = "de ";

if (utilisateur && utilisateur.pseudo_discord && voyelles.includes(utilisateur.pseudo_discord[0].toLowerCase())) {
    prefixe = "d’";
}

// Vérifie le nombre de message des joueurs
let messageFormat = " message"
const msgCount = stats?.nb_message ?? utilisateur?.nb_message ?? 0;

if (msgCount > 1) {
    messageFormat = " messages"
}
---
{!utilisateur && <h1>Joueur introuvable</h1>}
{utilisateur && (
<Layout ogImage={utilisateur?.avatar_url} title={`${utilisateur?.pseudo_discord}`}
        ogDescription={`Profil Discord : ${utilisateur?.pseudo_discord}`}>
    <Banner/>

    <div class="profile-container">
        <TransitionSection title={`Profil #Discord# ${prefixe}#${utilisateur.pseudo_discord}#`}/>

        <div class="profile-details">

            {/* Colonne 1 : Avatar */}
            <div class="avatar">
                <Image
                        src={utilisateur.avatar_url}
                        alt={`Avatar de ${utilisateur.pseudo_discord}`}
                        class="mx-auto rounded-lg object-cover h-[21em] min-h-[300px] w-auto max-w-full"
                        width={300}
                        height={300}
                        loading="eager"
                />
            </div>

            {/* Colonne 2 : Informations */}
            <div class="info-grid">
                <h2>Informations</h2>

                {/* Badges style */}
                <div class="server-card-footer">
                    <span class="server-card-badge version">{utilisateur.tag_discord}</span>
                    {utilisateur.roles?.map((role: Roles) => {
                        const isFounder = role.id === "1112707976273338470";
                        const isInvesti = role.id === "1113865928086655037";

                        let badgeClass = "server-card-badge modpack";
                        if (isFounder) badgeClass += " founder-role-badge";
                        else if (isInvesti) badgeClass += " special-role-badge";

                        return (
                                <span
                                        class={badgeClass}
                                        style={(isFounder || isInvesti) ? `--role-color: ${role.color};` : ''}
                                >
                                {role.name.replace(/\p{Extended_Pictographic}/gu, '').trim()}
                            </span>
                        )
                    })}
                </div>

                <div class="server-desc-container">
                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                            </svg>
                            Messages :
                        </strong>
                        <span>{stats?.nb_message} {messageFormat}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                            </svg>
                            Temps Vocal :
                        </strong>
                        <span>{vocalTimeFormater(stats?.vocal_time || 0)}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Activité récente :
                        </strong>
                        <span>{formatDate(utilisateur.last_activity)}</span>
                    </div>

                    <div class="stats-row">
                        <strong>
                            {/* J'ai changé l'icône et le texte pour correspondre à "Date d'arrivée" */}
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Date d'arrivée :
                        </strong>
                        <span>{formatDate(utilisateur.join_date_discord)}</span>
                    </div>
                </div>
            </div>

            {/* Colonne 3 : Actions / Comptes Liés */}
            <div class="info-grid">
                <h2>Comptes Liés</h2>
                <div class="server-boutons-container"
                     style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    {accountLinks.length > 0 ? (
                        accountLinks.map(account => (
                                <a href={`/joueurs/minecraft/${slugify(account.playername)}`} class="w-full">
                                <button class="super-button golden-outline w-full" style="border-radius: 5px">
                                    <span style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                                        <Image src={`https://mc-heads.net/avatar/${account.playername}/32`} alt="Head"
                                               width={24} height={24} class="rounded-sm"/>
                                        {account.playername}
                                    </span>
                                </button>
                            </a>
                        ))
                    ) : (
                            <div class="server-card-badge unactive" style="width: 100%; text-align: center;">Aucun
                                compte lié
                            </div>
                    )}
                </div>

                <div class="server-boutons-container">
                    <!--
                    <form id="link-account-form" data-user-id={utilisateur.id} class="w-full form-inline" style="display: flex; flex-direction: row; gap: 0.5rem; width: 100%;">
                        <input
                                type="text"
                                name="code"
                                placeholder="Code de liaison"
                                class="code-input"
                                required
                                style="flex: 1; padding: 0.5rem; border-radius: 5px; border: 2px solid #ccc;"
                        />
                        <button type="submit" class="super-button golden-outline" style="white-space: nowrap; width: auto; border-radius: 5px">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="scale-up-anim bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z"/>
                            </svg>
                        </button>
                    </form>
                         -->
                </div>
            </div>
        </div>

        <TransitionSection title={`%Badges% de l'utilisateur #${utilisateur.pseudo_discord}#`}/>
        <BadgeList PlayerOrUser="User" userId={utilisateur.id} categoryId={1}/>
    </div>

    <style>
        .profile-container {
            border-radius: 10px;
            text-align: center;
            font-family: Arial, sans-serif;
        }

        h2 {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            color: var(--h2TitleColor);
        }

        .profile-details {
            color: var(--pTextColor);
            display: grid;
            grid-template-columns: 0.6fr 1fr 0.6fr;
            gap: 1rem;
            align-items: flex-start;
            justify-items: center;
            padding: 2rem;
        }

        .avatar,
        .info-grid {
            width: 100%;
        }

        .avatar img {
            border-radius: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
            font-size: 0.9rem;
            text-align: left;
        }

        .server-desc-container {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Crée 2 colonnes de largeur égale */
            gap: 1rem; /* Espace entre les cellules */
            width: 100%;
        }

        .stats-row {
            display: flex;
            flex-direction: column;
            background-color: rgba(0, 0, 0, 0.03); /* Petit fond gris optionnel pour bien voir la grille */
            padding: 0.8rem;
            border-radius: 8px;
            text-align: left; /* Ou center selon votre préférence */
        }

        /* Optionnel : Passer à 1 colonne sur mobile */
        @media (max-width: 600px) {
            .server-desc-container {
                grid-template-columns: 1fr;
            }
        }

        .stats-row {
            display: flex;
            flex-direction: column;
        }

        .icon {
            display: inline;
            vertical-align: text-bottom;
            margin-right: 6px;
            color: var(--h2TitleColor); /* Utilisation de la variable globale ou fallback */
        }


        @media (max-width: 990px) {
            .profile-details {
                grid-template-columns: 1fr;
            }
            .info-grid {
                text-align: center;
            }
            .stats-row {
                align-items: center;
            }
        }
    </style>

</Layout>
    )}

<script>
