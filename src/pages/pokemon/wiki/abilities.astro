---
import LargeTransitionSection from "../../../components/sections/common/transitions/LargeTransitionSection.astro";
import Banner from "../../../components/sections/layout/Banner.astro";
import ContentLayout from "../../../components/wiki/ContentLayout.astro";
import Layout from "../../../layouts/Layout.astro";
import abilitiesIllustrations from "../../../assets/pokemon_wiki/_abilities.png";
import SlidingVignette from "../../../components/ui/vignettes/SlidingVignette.astro";
import TransitionSection from "../../../components/sections/common/transitions/TransitionSection.astro";


---

<Layout
        title="Talents"
        ogTitle="Talents du Royaume de Loutre Mer"
        ogDescription="La liste des talents Pokémon du Royaume de Loutre Mer, avec leurs effets sur le serveur Cobblemon de l'Antre des Loutres."
        ogImage={abilitiesIllustrations.src}
        ogImageAlt="Talents du Royaume de Loutre Mer"
        forceDarkTheme={true}
>
    <Banner />

    <LargeTransitionSection title="Accueil du #Wiki RLM#" invertedBackground/>

    <ContentLayout>
        <TransitionSection title="Page pas encore disponible, un #<a href='/pokemon/wiki/flammiko'>Flammiko</a># à fait tomber toutes nos infos..." invertedBackground/>
        <TransitionSection title="La liste des nouveaux talents sera disponible dans une prochaine<br>%mise à jour !%" invertedBackground/>
    </ContentLayout>
</Layout>