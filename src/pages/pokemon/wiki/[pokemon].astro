---
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/sections/layout/Banner.astro";
import LargeTransitionSection from "../../../components/sections/common/transitions/LargeTransitionSection.astro";
import EvolutionTreeHorizontal from "../../../components/wiki/EvolutionTreeHorizontal.astro";
import PkmnStatsGraph from "../../../components/wiki/PkmnStatsGraph.astro";

export async function getStaticPaths() {
    const pokemons = ["pikachu", "salameche", "bulbizarre", "carapuce"];

    return pokemons.map((pokemon) => ({
        params: { pokemon }
    }));
}

---

<Layout ogImage={`placeholder`} title={`Pokemonname`} ogDescription={`placeholder`}>
    <Banner bannerUrl="https://champions.pokemon.com/_images/global/header/header-lg.jpg"/>

    <div class="wiki-navigation-container">
        <a href="#"><div>
            <p>Page précédente</p>
            <img class="wiki-navigation-container-img" src="https://www.pokepedia.fr/images/thumb/7/7f/Arbok-RFVF.png/250px-Arbok-RFVF.png"/>
        </div></a>
        <a href="#"><div>
            <p>Page actuel</p>
            <img class="wiki-navigation-container-img" src="https://www.pokepedia.fr/images/thumb/e/e7/Pikachu-RFVF.png/250px-Pikachu-RFVF.png"/>
        </div></a>
        <a href="#"><div>
            <p>Page suivante</p>
            <img class="wiki-navigation-container-img" src="https://www.pokepedia.fr/images/thumb/5/57/Raichu-LPZA.png/250px-Raichu-LPZA.png"/>
        </div></a>
    </div>

    <LargeTransitionSection title={`Page de #Pikachu#`} invertedBackground/>

    <div class="wiki-main-container">
        <div class="wiki-primary-infos">
            <div class="wiki-col wiki-pokemon-artwork-container">
                <img class="wiki-pokemon-artwork" src="https://www.pokepedia.fr/images/thumb/e/e7/Pikachu-RFVF.png/250px-Pikachu-RFVF.png"/>
            </div>
            <div class="wiki-col wiki-pokemon-infos">
                <div class="wiki-pokemon-types-container">
                    <img class="wiki-pokemon-type-image" src="https://www.pokepedia.fr/images/thumb/6/6d/Miniature_Type_%C3%89lectrik_EV.png/180px-Miniature_Type_%C3%89lectrik_EV.png"/>
                    <img class="wiki-pokemon-type-image" src="https://www.pokepedia.fr/images/thumb/b/bf/Miniature_Type_Normal_EV.png/180px-Miniature_Type_Normal_EV.png"/>
                </div>
                <h1 style="margin-top: 1em">Pokemon Souris</h1>
                <h1 style="margin-top: 1em">Talents :</h1>
                <ul>
                    <li>- Static</li>
                    <li>- Paratonnerre</li>
                </ul>
            </div>
            <div class="wiki-col wiki-pokemon-stats-container">
                <PkmnStatsGraph hpValue={35} attackValue={55} defenseValue={40} specialAttackValue={50} specialDefenseValue={50} speedValue={90} />
            </div>
        </div>

        <EvolutionTreeHorizontal
            color="yellow"
            stages={[
                { type: "pokemon", name: "Pichu", image: "https://www.pokepedia.fr/images/thumb/a/a0/Pichu-RFVF.png/250px-Pichu-RFVF.png" },
                { type: "condition", label: "Amitié" },
                { type: "pokemon", name: "Pikachu", image: "https://www.pokepedia.fr/images/thumb/e/e7/Pikachu-RFVF.png/250px-Pikachu-RFVF.png" },
                { type: "condition", label: "Pierre foudre" },
                { type: "pokemon", name: "Raichu", image: "https://www.pokepedia.fr/images/thumb/5/57/Raichu-LPZA.png/250px-Raichu-LPZA.png" },
                { type: "condition", label: "Méga-Évolution" },
                { type: "pokemon", name: "Méga-Raichu X", image: "https://www.pokepedia.fr/images/thumb/9/98/M%C3%A9ga-Raichu_X_%28Official_Game_Art%29-LPZA.png/250px-M%C3%A9ga-Raichu_X_%28Official_Game_Art%29-LPZA.png" },
            ]}
        />
        <EvolutionTreeHorizontal
            color="yellow"
            stages={[
                { type: "pokemon", name: "Pichu", image: "https://www.pokepedia.fr/images/thumb/a/a0/Pichu-RFVF.png/250px-Pichu-RFVF.png" },
                { type: "condition", label: "Amitié" },
                { type: "pokemon", name: "Pikachu", image: "https://www.pokepedia.fr/images/thumb/e/e7/Pikachu-RFVF.png/250px-Pikachu-RFVF.png" },
                { type: "condition", label: "Pierre foudre" },
                { type: "pokemon", name: "Raichu", image: "https://www.pokepedia.fr/images/thumb/5/57/Raichu-LPZA.png/250px-Raichu-LPZA.png" },
                { type: "condition", label: "Méga-Évolution" },
                { type: "pokemon", name: "Méga-Raichu Y", image: "https://www.pokepedia.fr/images/thumb/7/7a/M%C3%A9ga-Raichu_Y_%28Official_Game_Art%29-LPZA.png/250px-M%C3%A9ga-Raichu_Y_%28Official_Game_Art%29-LPZA.png" },
            ]}
        />
        <EvolutionTreeHorizontal
                color="yellow"
            stages={[
                { type: "pokemon", name: "Pichu", image: "https://www.pokepedia.fr/images/thumb/a/a0/Pichu-RFVF.png/250px-Pichu-RFVF.png" },
                { type: "condition", label: "Amitié" },
                { type: "pokemon", name: "Pikachu", image: "https://www.pokepedia.fr/images/thumb/e/e7/Pikachu-RFVF.png/250px-Pikachu-RFVF.png" },
                { type: "condition", label: "Pierre foudre" },
                { type: "pokemon", name: "Raichu (Alola)", image: "https://www.pokepedia.fr/images/thumb/7/79/Raichu_d%27Alola-SL.png/250px-Raichu_d%27Alola-SL.png" },
            ]}
        />


    </div>

</Layout>

<style>

    * {
        color: white;
        box-sizing: border-box;
    }

    h1 {
        font-size: 1.2rem;
        font-weight: bold;
    }

    .wiki-main-container {
        max-width: 1050px;
        margin: 0 auto 5rem;
        padding: 0 1rem;
    }

    .wiki-navigation-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        justify-items: center;

        text-align: center;
        border-top: 1px solid white;
        border-bottom: 1px solid white;
        padding: 1rem 0;
        gap: 1rem;
    }

    .wiki-navigation-container-img {
        height: 5em;
        max-width: 100%;
    }

    .wiki-primary-infos {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .wiki-col {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }


    .wiki-pokemon-types-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .wiki-pokemon-type-image {
        height: 1.5em;
        max-width: 100%;
    }

    .wiki-pokemon-artwork {
        max-width: 100%;
        height: auto;
    }

    @media (max-width: 846px) {

        .wiki-primary-infos {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .wiki-navigation-container {
            grid-template-columns: 1fr;
        }

    }

</style>