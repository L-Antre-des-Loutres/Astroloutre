---
import {getCollection} from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import SlidingVignette from "../../components/ui/vignettes/SlidingVignette.astro";
import {slugify} from "../../formater/JoueurFormater";
import LargeTransitionSection from "../../components/sections/common/transitions/LargeTransitionSection.astro";

const tag = Astro.url.searchParams.get('tag');
const articles = await getCollection('blog');

// Tri par date de publication décroissante et filtre par tag si un tag est spécifié
const filteredArticles = tag
    ? articles.filter(article => article.data.tags?.includes(tag))
    : articles;
filteredArticles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Projets" ogTitle="Projets - Antre des loutres" ogDescription="Projets de l'antre des loutres">
    <Banner/>
    <LargeTransitionSection title="Nos %super projets% !" invertedBackground/>

    <div class="projects-container">
        <ul class="projects-list">
            {filteredArticles.map((article) => (
                <SlidingVignette image={article.data.image || ""} image_alt={article.data.title} title=`#${article.data.title}#` paragraph={article.data.description} card_link={`/projets/${slugify(article.data.title)}`} margin="0.8em"/>
            ))}
        </ul>
    </div>

</Layout>

<style>
    .projects-container {
        margin: 0 auto;
        padding-left: 2rem;
        padding-right: 2rem;
        padding-bottom: 2rem;
        max-width: 1400px;
        width: 100%;
    }

    .projects-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        list-style: none;
        padding: 0;
        margin: 0 auto;
        width: 100%;

        justify-items: center;
        align-items: start;
    }

    @media (max-width: 900px) {
        .projects-container {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }
    }

    @media (max-width: 500px) {
        .projects-container {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .projects-list {
            grid-template-columns: 1fr;
            gap: 1.2rem;
        }
    }
</style>