---
import {getCollection} from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/Banner.astro";
import SlidingVignette from "../../components/vignettes/SlidingVignette.astro";
import {slugify} from "../../formater/JoueurFormater";
import LargeBanner from "../../components/transitions/LargeBanner.astro";

const tag = Astro.url.searchParams.get('tag');
const articles = await getCollection('blog');

// Tri par date de publication décroissante et filtre par tag si un tag est spécifié
const filteredArticles = tag
    ? articles.filter(article => article.data.tags?.includes(tag))
    : articles;
filteredArticles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<Layout title="Projets" ogTitle="Projets - Antre des loutres" ogDescription="Projets de l'antre des loutres">
    <Banner/>
    <LargeBanner title="Nos %super projets% !" invertedBackground/>

    <div class="projects-container">
        <ul class="projects-list">
            {filteredArticles.map((article) => (
                <SlidingVignette image={article.data.image} image_alt={article.data.title} title={article.data.title} paragraph={article.data.description} card_link={`/projets/${slugify(article.data.title)}`} margin="0px" transform_anim={false}/>
            ))}
        </ul>
    </div>

</Layout>

<style>
    .projects-container {
        margin: 0 auto;
        padding-left: 10rem;
        padding-right: 10rem;
    }

    .projects-list {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        list-style: none;
        padding: 0;
    }
</style>