---
import {getCollection, render} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import {slugify} from "../../formater/JoueurFormater";
import LargeTransitionSection from "../../components/sections/common/transitions/LargeTransitionSection.astro";
import SlidingVignette from "../../components/ui/vignettes/SlidingVignette.astro";

export async function getStaticPaths() {
    const projets = await getCollection("blog");

    return projets.map((projet) => ({
        params: {title: slugify(projet.data.title)},
        props: {projet},
    }));
}

const {projet} = Astro.props;
const {Content} = await render(projet);

// Fetch other articles
const tag = Astro.url.searchParams.get("tag");
const articles = await getCollection("blog");

// Filter acticles (Exclure le projet courant pour ne pas le voir à droite)
const filteredArticles = articles
    .filter((article) => article.id !== projet.id) // On exclut le projet actuel
    .filter((article) => (tag ? article.data.tags?.includes(tag) : true))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title={projet.data.title}>
    <Banner/>
    <LargeTransitionSection
            title={`#${projet.data.title}#`}
            invertedBackground
    />

    <div class="project-layout">
        <main class="project-content">
            <div class="project-header">
                <img
                        src={projet.data.image}
                        alt={projet.data.title}
                        class="main-image"
                />

                <div class="meta-info">
                    <small class="vignette-date">
                        {
                            new Date(projet.data.pubDate).toLocaleDateString(
                                "fr-FR",
                                {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric",
                                },
                            )
                        }
                    </small>
                    <div class="tag-pill-labels-list-container">
                        {
                            projet.data.tags.map((tag) => (
                                    <span class="tag-pill-labels">{tag}</span>
                            ))
                        }
                    </div>
                </div>

                <p class="note-description">{projet.data.description}</p>
            </div>

            <article class="markdown-body">
                <Content/>
            </article>
        </main>

        <aside class="project-sidebar">
            <h2 class="default-h2">Autres projets</h2>
            <div class="sidebar-list">
                {
                    filteredArticles.map((article) => (
                            <SlidingVignette
                            image={article.data.image}
                            image_alt={article.data.title}
                            title={`#${article.data.title}#`}
                            paragraph={
                                article.data.description.length > 100
                                    ? `${article.data.description.slice(0, 100)}...`
                                    : article.data.description
                            }
                            card_link={`/projets/${slugify(article.data.title)}`}
                            margin="0.8em"
                            />
                    ))
                }
            </div>
            <button class="super-button golden-outline">
                <a href="/projets">Retour à la liste</a>
                <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        class="right-slide-anim bi bi-caret-right-fill"
                        viewBox="0 0 16 16"
                >
                    <path
                            d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"
                    ></path>
                </svg>
            </button>
        </aside>
    </div>
</Layout>

<style>
    .project-layout {
        max-width: 1400px;
        margin: 0 auto;
        padding: 4rem 2rem;
        padding-top: 0;
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 4rem;
        align-items: start;
    }

    /* Style for main content column */
    .project-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .main-image {
        max-width: 100%;
        width: auto;
        height: auto;
        max-height: 200px;
        margin-bottom: 1.5rem;
        display: block;
        margin-left: auto;
        margin-right: auto;
        object-fit: contain;
    }

    .meta-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .markdown-body {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--markdown-default-color);
    }

    /* Style for markdown */
    .markdown-body :global(h1) {
        margin-top: 2em;
        font-size: 2rem;
        font-weight: bolder;
        color: var(--markdown-h1-default-color);
    }

    .markdown-body :global(h2) {
        margin-top: 2em;
        font-size: 1.8rem;
        font-weight: bolder;
        color: var(--markdown-h2-default-color);
    }

    .markdown-body :global(h3) {
        margin-top: 1.5em;
        font-size: 1.4rem;
        font-weight: bold;
        color: var(--markdown-h3-default-color);
    }

    .markdown-body :global(p) {
        margin-bottom: 1.5em;
    }

    .markdown-body :global(ul) {
        padding-left: 1.5em;
        margin-bottom: 1.5em;
    }

    .markdown-body :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .markdown-body :global(pre) /* Code blocs */ {
        padding: 1em 1.5em;
        border-radius: 8px;
        margin-bottom: 1.5em;
        overflow-x: auto;
        line-height: 1.6;
    }

    /* Style for sticky sidebar column */
    .project-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .sidebar-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media (max-width: 900px) {
        .project-layout {
            grid-template-columns: 1fr;
            padding: 2rem 1rem;
            gap: 3rem;
        }

        .project-sidebar {
            position: static; /* No sticky on mobile & small screens */
            order: 2;
        }

        .sidebar-list {
            /* Grid project cards */
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }
    }
</style>
