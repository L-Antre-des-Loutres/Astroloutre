---
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/sections/layout/Banner.astro";
import {slugify} from "../../formater/JoueurFormater";
import LargeTransitionSection from "../../components/sections/common/transitions/LargeTransitionSection.astro";
import SlidingVignette from "../../components/ui/vignettes/SlidingVignette.astro";
import { ApiFetcher } from "../../utils/API/apiFetcher";
import { POCKETBASE_COLLECTION_PROJETS, PB_URL } from "../../utils/constantes";
import type { ProjectType } from "../../types/ProjectType";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
    const allProjets = await ApiFetcher.getAllRecords<ProjectType & { created: string }>(POCKETBASE_COLLECTION_PROJETS, {
        expand: 'tags'
    });

    const projets = allProjets.filter(p => p.expand?.tags?.some(t => t.name.toLowerCase() === "antre des loutres" || t.name.toLowerCase() === "antre des loutre"));

    const githubToken = import.meta.env.GITHUB_TOKEN;
    const headers = githubToken ? { 'Authorization': `token ${githubToken}` } : {};

    const cachePath = path.resolve('./src/data/github-cache.json');
    let githubCache: Record<string, any> = {};
    if (fs.existsSync(cachePath)) {
        try {
            githubCache = JSON.parse(fs.readFileSync(cachePath, 'utf8'));
        } catch(e) {}
    }
    let cacheUpdated = false;

    const paths = await Promise.all(projets.map(async (projet) => {
        let readmeHtml = "<p>Aucun README disponible.</p>";
        let contributors = [];
        let version = "En cours de développement";
        let languages: Record<string, number> = {};
        let lastCommitDate = "";

        if (projet.repository) {
            // Extraction du format owner/repo (ex: Astroloutre/Astroloutre_dev)
            // On gère le cas où l'utilisateur a rentré une URL complète ou juste "owner/repo"
            let repoPath = projet.repository;
            if (repoPath.includes("github.com/")) {
                repoPath = repoPath.split("github.com/")[1];
            }
            // Enlever l'éventuel slash à la fin
            repoPath = repoPath.replace(/\/$/, "");

            try {
                let defaultBranch = "main";
                let pushedAt = "";
                let useCache = false;
                
                // Fetch the repo info first to get pushed_at
                const repoRes = await fetch(`https://api.github.com/repos/${repoPath}`, { headers });
                if (repoRes.ok) {
                    const repoData = await repoRes.json();
                    defaultBranch = repoData.default_branch || "main";
                    pushedAt = repoData.pushed_at || "";
                    
                    if (pushedAt && githubCache[repoPath] && githubCache[repoPath].pushedAt === pushedAt) {
                        useCache = true;
                    }
                }

                if (useCache) {
                    readmeHtml = githubCache[repoPath].readmeHtml || readmeHtml;
                    contributors = githubCache[repoPath].contributors || [];
                    version = githubCache[repoPath].version || version;
                    languages = githubCache[repoPath].languages || {};
                    lastCommitDate = githubCache[repoPath].lastCommitDate || pushedAt;
                } else {
                    // 1. Fetch README
                    const readmeRes = await fetch(`https://api.github.com/repos/${repoPath}/readme`, { headers });
                    if (readmeRes.ok) {
                        const readmeData = await readmeRes.json();
                        let markdown = Buffer.from(readmeData.content, 'base64').toString('utf8');


                    const rawBase = `https://raw.githubusercontent.com/${repoPath}/${defaultBranch}/`;
                    const blobBase = `https://github.com/${repoPath}/blob/${defaultBranch}/`;

                    // Remplacer les images relatives Markdown : ![alt](src)
                    markdown = markdown.replace(/!\[([^\]]*)\]\((?!http|\/\/|data:)([^)]+)\)/g, `![$1](${rawBase}$2)`);
                    // Remplacer les images relatives HTML : <img src="src">
                    markdown = markdown.replace(/<img([^>]+)src=["'](?!http|\/\/|data:)([^"']+)["']([^>]*)>/gi, `<img$1src="${rawBase}$2"$3>`);
                    // Remplacer les liens relatifs Markdown : [text](link)
                    markdown = markdown.replace(/\[([^\]]+)\]\((?!http|\/\/|#|mailto:)([^)]+)\)/g, `[$1](${blobBase}$2)`);
                    // Remplacer les liens relatifs HTML : <a href="link">
                    markdown = markdown.replace(/<a([^>]+)href=["'](?!http|\/\/|#|mailto:)([^"']+)["']([^>]*)>/gi, `<a$1href="${blobBase}$2"$3>`);

                    // Regrouper les badges qui se suivent (séparés par des retours à la ligne) sur la même ligne
                    const badgeRegex = /(?:\[?!\[[^\]]*\]\([^)]+\)\]?(?:\([^)]+\))?|<a[^>]*>\s*<img[^>]+>\s*<\/a>|<img[^>]+>)\s*\n+\s*(?=(?:\[?!\[[^\]]*\]\([^)]+\)\]?(?:\([^)]+\))?|<a[^>]*>\s*<img[^>]+>\s*<\/a>|<img[^>]+>))/gi;
                    let previousMarkdown;
                    do {
                        previousMarkdown = markdown;
                        markdown = markdown.replace(badgeRegex, (match) => match.replace(/\n+/g, ' '));
                    } while(markdown !== previousMarkdown);

                    readmeHtml = marked.parse(markdown) as string;
                    
                    // Sécurité supplémentaire : regrouper les badges HTML séparés par <br> ou <p> générés par le parseur
                    const badgeHtmlRegex = /(<img[^>]+(?:shields\.io|badge)[^>]*>(?:\s*<\/a>)?)\s*(?:<br\s*\/?>|<\/p>\s*<p(?: [^>]*)?>)\s*(?=(?:<a[^>]*>\s*)?<img[^>]+(?:shields\.io|badge)[^>]*>)/gi;
                    let previousHtml;
                    do {
                        previousHtml = readmeHtml;
                        readmeHtml = readmeHtml.replace(badgeHtmlRegex, '$1 ');
                    } while (readmeHtml !== previousHtml);
                }

                // 2. Fetch Contributors
                const contribsRes = await fetch(`https://api.github.com/repos/${repoPath}/contributors?per_page=10`, { headers });
                if (contribsRes.ok) {
                    contributors = await contribsRes.json();
                }

                // 3. Fetch Release/Version
                const releaseRes = await fetch(`https://api.github.com/repos/${repoPath}/releases/latest`, { headers });
                if (releaseRes.ok) {
                    const releaseData = await releaseRes.json();
                    version = releaseData.tag_name || releaseData.name || version;
                    if (releaseData.prerelease) {
                        version += " (Pre-release)";
                    }
                } else {
                    // S'il n'y a pas de release 'latest', on cherche les releases générales
                    const allReleasesRes = await fetch(`https://api.github.com/repos/${repoPath}/releases?per_page=1`, { headers });
                    if (allReleasesRes.ok) {
                        const allReleasesData = await allReleasesRes.json();
                        if (allReleasesData.length > 0) {
                            version = allReleasesData[0].tag_name || allReleasesData[0].name || version;
                            if (allReleasesData[0].prerelease) {
                                version += " (Pre-release)";
                            }
                        }
                    }
                }

                // 4. Fetch Languages
                const langRes = await fetch(`https://api.github.com/repos/${repoPath}/languages`, { headers });
                if (langRes.ok) {
                    languages = await langRes.json();
                }

                lastCommitDate = pushedAt;
                githubCache[repoPath] = {
                    pushedAt,
                    readmeHtml,
                    contributors,
                    version,
                    languages,
                    lastCommitDate
                };
                cacheUpdated = true;
            }

            } catch (e) {
                console.error(`Erreur lors de la récupération GitHub pour ${repoPath}:`, e);
            }
        }

        return {
            params: {title: slugify(projet.name)},
            props: {
                projet,
                readmeHtml,
                contributors,
                version,
                languages,
                lastCommitDate
            },
        };
    }));

    if (cacheUpdated) {
        const dir = path.dirname(cachePath);
        if (!fs.existsSync(dir)) {
            fs.mkdirSync(dir, { recursive: true });
        }
        fs.writeFileSync(cachePath, JSON.stringify(githubCache, null, 2), 'utf8');
    }

    return paths;
}

const {projet, readmeHtml, contributors, version, languages, lastCommitDate} = Astro.props;

// Fetch other articles (other projects)
const allProjects = await ApiFetcher.getAllRecords<ProjectType & { created: string }>(POCKETBASE_COLLECTION_PROJETS, {
    expand: 'tags'
});

const tag = Astro.url.searchParams.get("tag");

// Filter articles (Exclure le projet courant pour ne pas le voir à droite)
const filteredArticles = allProjects
    .filter((p) => p.expand?.tags?.some(t => t.name.toLowerCase() === "antre des loutres" || t.name.toLowerCase() === "antre des loutre"))
    .filter((p) => p.id !== projet.id) // On exclut le projet actuel
    .filter((p) => (tag ? p.expand?.tags?.some(t => t.name === tag) : true))
    .sort((a, b) => new Date(b.created).getTime() - new Date(a.created).getTime());

const imageUrl = projet.logo ? `${PB_URL}/api/files/${projet.collectionId}/${projet.id}/${projet.logo}` : "";

// Process language statistics
function getLanguageColor(langName: string) {
    const predefinedColors: Record<string, string> = {
        'TypeScript': '#3178c6',
        'JavaScript': '#f1e05a',
        'Java': '#b07219',
        'Python': '#3572A5',
        'HTML': '#e34c26',
        'CSS': '#563d7c',
        'Astro': '#ff5a03',
        'Vue': '#41b883',
        'C++': '#f34b7d',
        'C#': '#178600',
        'Shell': '#89e051',
        'PHP': '#4F5D95',
        'Ruby': '#701516',
        'Go': '#00ADD8',
        'Rust': '#dea584'
    };
    if (predefinedColors[langName]) return predefinedColors[langName];
    
    let hash = 0;
    for (let i = 0; i < langName.length; i++) {
        hash = langName.charCodeAt(i) + ((hash << 5) - hash);
    }
    const color = Math.floor(Math.abs((Math.sin(hash) * 10000) % 1 * 16777215)).toString(16);
    return '#' + '000000'.substring(0, 6 - color.length) + color;
}

const totalLanguageBytes = languages ? Object.values(languages).reduce((a: any, b: any) => a + b, 0) : 0;
const languageStats = languages && totalLanguageBytes > 0 ? Object.entries(languages).map(([lang, bytes]: [string, any]) => {
    return {
        name: lang,
        percent: ((bytes / totalLanguageBytes) * 100).toFixed(1),
        color: getLanguageColor(lang)
    };
}).sort((a, b) => parseFloat(b.percent) - parseFloat(a.percent)) : [];
---

<Layout title={projet.name}>
    <Banner/>
    <LargeTransitionSection
            title={`#${projet.name}#`}
            invertedBackground
    />

    <div class="project-layout">
        <main class="project-content">
            <div class="project-header">
                {imageUrl && (
                    <img
                            src={imageUrl}
                            alt={projet.name}
                            class="main-image"
                    />
                )}

                <div class="meta-info">
                    <small class="vignette-date">
                        {
                            new Date(projet.created).toLocaleDateString(
                                "fr-FR",
                                {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric",
                                },
                            )
                        }
                    </small>
                    <div class="tag-pill-labels-list-container">
                        {
                            projet.expand?.tags?.map((t: any) => (
                                t.name.toLowerCase() !== "antre des loutres" && t.name.toLowerCase() !== "antre des loutre" && (
                                    <span class="tag-pill-labels">{t.name}</span>
                                )
                            ))
                        }
                    </div>
                </div>
                
                <div class="project-badges">
                    {!projet.is_maintained && (
                        <span class="badge badge-deprecated">🚧 Non maintenu (Archivé)</span>
                    )}
                    <span class="badge badge-version">🏷️ Version: {version}</span>
                    
                    {lastCommitDate && (
                        <span class="badge badge-date" title="Dernier commit">
                            📅 Dernier commit : {new Date(lastCommitDate).toLocaleDateString("fr-FR", {day: "numeric", month: "short", year: "numeric"})}
                        </span>
                    )}
                    
                    {projet.repository && (
                        <a href={projet.repository.startsWith('http') ? projet.repository : `https://github.com/${projet.repository}`} target="_blank" rel="noopener noreferrer" class="badge badge-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                            Code source
                        </a>
                    )}
                    {projet.publish_url && (
                        <a href={projet.publish_url} target="_blank" rel="noopener noreferrer" class="badge badge-link badge-publish">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M10.478 1.647a.5.5 0 1 0-.956-.294l-4 13a.5.5 0 0 0 .956.294l4-13zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0zm6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0z"/></svg>
                            Ouvrir le projet
                        </a>
                    )}
                    {projet.wiki_url && (
                        <a href={projet.wiki_url} target="_blank" rel="noopener noreferrer" class="badge badge-link badge-wiki">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M2.5 3.5a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1h-11zm2 3a.5.5 0 0 1 0-1h7a.5.5 0 0 1 0 1h-7zM0 13a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 16 13V6a1.5 1.5 0 0 0-1.5-1.5h-13A1.5 1.5 0 0 0 0 6v7zm1.5-.5V6h13v6.5h-13z"/></svg>
                            Wiki
                        </a>
                    )}
                </div>

                <p class="note-description">{projet.description}</p>
                
                <div class="header-details-row">
                    {contributors && contributors.length > 0 && (
                        <div class="contributors-section">
                            <h3>Contributeurs</h3>
                            <div class="contributors-list">
                                {contributors.map((contrib: any) => (
                                    <a href={contrib.html_url} target="_blank" rel="noopener noreferrer" class="contributor-avatar" title={contrib.login}>
                                        <img src={contrib.avatar_url} alt={contrib.login} />
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {languageStats.length > 0 && (
                        <div class="languages-section">
                            <h3>Langages</h3>
                            <div class="language-bar">
                                {languageStats.map((lang) => (
                                    <div class="language-segment" style={`width: ${lang.percent}%; background-color: ${lang.color};`} title={`${lang.name}: ${lang.percent}%`}></div>
                                ))}
                            </div>
                            <ul class="language-legend">
                                {languageStats.map((lang) => (
                                    <li>
                                        <span class="color-dot" style={`background-color: ${lang.color};`}></span>
                                        <span class="lang-name">{lang.name}</span>
                                        <span class="lang-percent">{lang.percent}%</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </div>
            </div>

            {
                readmeHtml ? (
                    <article class="markdown-body" set:html={readmeHtml} />
                ) : (
                    <div class="no-readme-message">
                        <p>Aucun README disponible pour ce projet.</p>
                    </div>
                )
            }
            
        </main>

        <aside class="project-sidebar">
            <h2 class="default-h2">Autres projets</h2>
            <div class="sidebar-list">
                {
                    filteredArticles.map((article) => {
                        const sideImg = article.logo ? `${PB_URL}/api/files/${article.collectionId}/${article.id}/${article.logo}` : "";
                        return <SlidingVignette
                        image={sideImg}
                        image_alt={article.name}
                        title={`#${article.name}#`}
                        paragraph={
                            article.description && article.description.length > 100
                                ? `${article.description.slice(0, 100)}...`
                                : article.description
                        }
                        card_link={`/projets/${slugify(article.name)}`}
                        margin="0.8em"
                        />
                    })
                }
            </div>
            <button class="super-button golden-outline">
                <a href="/projets">Retour à la liste</a>
                <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        class="right-slide-anim bi bi-caret-right-fill"
                        viewBox="0 0 16 16"
                >
                    <path
                            d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"
                    ></path>
                </svg>
            </button>
        </aside>
    </div>
</Layout>

<style>
    .project-layout {
        max-width: 1400px;
        margin: 0 auto;
        padding: 4rem 2rem;
        padding-top: 0;
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 4rem;
        align-items: start;
    }

    /* Style for main content column */
    .project-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .main-image {
        max-width: 100%;
        width: auto;
        height: auto;
        max-height: 200px;
        margin-bottom: 1.5rem;
        display: block;
        margin-left: auto;
        margin-right: auto;
        object-fit: contain;
    }

    .meta-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .project-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        align-items: center;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        background-color: var(--card-bg, #2a2a2a);
        color: var(--text-color, #e0e0e0);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .badge-deprecated {
        background-color: rgba(220, 53, 69, 0.15);
        color: #ff6b6b;
        border-color: rgba(220, 53, 69, 0.3);
    }
    
    .badge-version {
        background-color: rgba(13, 110, 253, 0.15);
        color: var(--color-blue, #6ea8fe);
        border-color: rgba(13, 110, 253, 0.3);
    }
    
    .badge-link {
        transition: all 0.2s ease;
        text-decoration: none;
    }
    
    .badge-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    .badge-publish {
        background-color: rgba(25, 135, 84, 0.15);
        color: var(--color-green, #75b798);
        border-color: rgba(25, 135, 84, 0.3);
    }

    .badge-wiki {
        background-color: rgba(255, 193, 7, 0.15);
        color: var(--color-gold-deep, #ffda6a);
        border-color: rgba(255, 193, 7, 0.3);
    }
    
    .contributors-section {
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .contributors-section h3 {
        font-size: 1.5rem;
        margin-bottom: 1.2rem;
        color: var(--h2-title-color, var(--default-text-color));
    }
    
    .contributors-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
    }
    
    .contributor-avatar {
        display: inline-block;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--accent-color, #ffaa00);
        transition: transform 0.2s ease;
    }
    
    .contributor-avatar:hover {
        transform: scale(1.1);
    }
    
    .contributor-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .markdown-body {
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--default-text-color, #e0e0e0);
    }

    /* Style for markdown */
    .markdown-body :global(h1) {
        margin-top: 2em;
        font-size: 2.2rem;
        font-weight: bolder;
        color: var(--h1-title-color, #FF8C42);
        border-bottom: 1px solid var(--server-screen-color-border, rgba(255, 255, 255, 0.1));
        padding-bottom: 0.3em;
    }

    .markdown-body :global(h2) {
        margin-top: 2em;
        font-size: 1.8rem;
        font-weight: bolder;
        color: var(--h2-title-color, #b9bec6);
        border-bottom: 1px solid var(--server-screen-color-border, rgba(255, 255, 255, 0.1));
        padding-bottom: 0.3em;
    }

    .markdown-body :global(h3) {
        margin-top: 1.5em;
        font-size: 1.4rem;
        font-weight: bold;
        color: var(--h3-title-color, #b9bec6);
    }

    .markdown-body :global(p) {
        margin-bottom: 1.5em;
    }

    .markdown-body :global(ul), .markdown-body :global(ol) {
        padding-left: 1.5em;
        margin-bottom: 1.5em;
    }

    .markdown-body :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 0.2em 0.2em 0.2em 0;
    }

    .markdown-body :global(blockquote) {
        border-left: 4px solid var(--badge-list-color-accent, var(--color-gold-deep));
        padding: 0.5em 1em;
        margin: 1.5em 0;
        background-color: var(--server-screen-color-bg-card, rgba(0,0,0,0.05));
        border-radius: 4px;
        color: var(--default-text-color, #e0e0e0);
        font-style: italic;
    }

    .markdown-body :global(pre) /* Code blocs */ {
        padding: 1em 1.5em;
        border-radius: 8px;
        margin-bottom: 1.5em;
        overflow-x: auto;
        line-height: 1.6;
        background-color: #1e1e1e;
        color: #d4d4d4;
        border: 1px solid var(--server-screen-color-border, rgba(128, 128, 128, 0.2));
    }
    
    .markdown-body :global(code) {
        background-color: rgba(128, 128, 128, 0.15);
        padding: 0.2em 0.4em;
        border-radius: 4px;
