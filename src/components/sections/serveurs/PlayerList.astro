---
import {slugify} from "../../../formater/JoueurFormater.ts";
import {formatUUID} from "../../../formater/UUIDFormater.ts";
import {ApiFetcher} from "../../../utils/API/apiFetcher";
import {PLAYERS, PLAYERS_STATS} from "../../../utils/constantes";
import type {PlayerType} from "../../../types/PlayerType";

const { serveurId } = Astro.props;

// Récupération des stats du serveur et de la liste globale des joueurs
const allServerStats = await ApiFetcher.getAllRecords<any>(PLAYERS_STATS);
const statsForThisServer = allServerStats.filter(s => s.server === serveurId);

const allPlayers = await ApiFetcher.getAllRecords<PlayerType>(PLAYERS);

// Mapping pour retrouver le playername via l'account_id (UUID)
const playerDataList = statsForThisServer.map(stat => {
    const player = allPlayers.find(p => p.account_id === stat.account_id);
    return {
        playername: player ? player.playername : "Inconnu",
        account_id: stat.account_id
    };
}).filter(p => p.playername !== "Inconnu");

// Dédoublonnement au cas où
const seen = new Set();
const uniquePlayers = playerDataList.filter(el => {
    const duplicate = seen.has(el.account_id);
    seen.add(el.account_id);
    return !duplicate;
});
---
<div class="player-grid">
    {uniquePlayers.map((player) => (
            <a href={`/joueurs/minecraft/${slugify(player.playername)}`}>
                <div class="player-card">
                    <img
                            class="player-avatar"
                            src={`https://mc-heads.net/avatar/${formatUUID(player.account_id)}/64`}
                            alt={`Avatar de ${player.playername}`}
                    />
                    <div class="player-name">{player.playername}</div>
                </div>
            </a>
    ))}
</div>


<style>
    .player-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1rem;
        padding: 1rem;
    }

    .player-card {
        background-color: var(--server-player-vignette-background-color);
        border: 2px solid var(--server-player-vignette-outline-color);
        border-radius: 0.5rem;
        text-align: center;
        padding: 1rem;
        transition: transform 0.2s ease;
    }

    .player-card:hover {
        transform: scale(1.05);
    }

    .player-avatar {
        width: 64px;
        height: 64px;
        margin: 0 auto 0.5rem;
        border-radius: 0.25rem;
    }

    .player-name {
        font-weight: 600;
        color: var(--server-player-vignette-playername-color);
        font-size: 0.9rem;
        word-break: break-word;
    }
</style>