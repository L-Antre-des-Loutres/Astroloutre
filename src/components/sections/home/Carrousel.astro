---
import {Image} from 'astro:assets';
import {ApiFetcher} from "../../../utils/API/apiFetcher";
import {PB_URL, PLAYER_SCREENSHOTS} from "../../../utils/constantes";
import type {PlayerScreenshotType} from "../../../types/PlayerScreenshoot";

// Fonction de mélange
const shuffleArray = (array: any[]) => {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
};

let minecraftImages: any[] = [];
let pokemonImages: any[] = [];
let palworldImages: any[] = [];

try {
    // Récupération des images via PocketBase avec expansion des relations
    const screenshots = await ApiFetcher.pb.collection(PLAYER_SCREENSHOTS).getFullList<PlayerScreenshotType>({
        filter: 'is_in_carousel = true',
        expand: 'player,server,server.platform,discord_users,platform',
        requestKey: null
    });

    const mapScreenshot = (img: PlayerScreenshotType) => {
        const imageUrl = `${PB_URL}/api/files/${img.collectionId}/${img.id}/${img.screenshot}`;
        const author = img.expand?.player?.playername || img.expand?.discord_users?.username || "Une loutre anonyme";
        const serverName = img.expand?.server?.name;
        
        // On récupère le nom de la plateforme via le serveur OU directement via la plateforme liée
        const platformName = (
            img.expand?.server?.expand?.platform?.name || 
            (img as any).expand?.platform?.name || 
            "minecraft"
        ).toLowerCase();

        const attribution = serverName 
            ? `Image par ${author} sur ${serverName}`
            : `Image par ${author}`;

        return {
            path: imageUrl,
            attribution,
            platform: platformName
        };
    };

    const mappedImages = screenshots.map(mapScreenshot);

    minecraftImages = mappedImages.filter(img => img.platform === "minecraft");
    pokemonImages = mappedImages.filter(img => img.platform === "pokemon");
    palworldImages = mappedImages.filter(img => img.platform === "palworld");

} catch (error) {
    console.error("Erreur lors de la récupération des images du carrousel :", error);
}

const games = [
    {
        name: 'Minecraft',
        icon: '/icons/logo_minecraft_mini.png',
        logo: '/icons/logo_minecraft.svg',
        slides: shuffleArray(minecraftImages),
        buttons: {
            servers: {
                title: "Nos serveurs",
                link: "/serveurs/minecraft"
            },
            classement: {
                title: "Classements",
                link: "/classements/minecraft"
            },
            Addons: {
                title: "Addons",
                link: "/projets/tag/Minecraft Content"
            }
        }
    },
    {
        name: 'Pokemon',
        icon: '/icons/pokemon_icon.webp',
        logo: '/icons/pokemon_logo.webp',
        slides: shuffleArray(pokemonImages),
        buttons: {
            wiki: {
                title: "Wiki de nos Pokemon",
                link: "/pokemon/wiki/home"
            },
            classement: {
                title: "Classement Pokedeviner",
                link: "/classements/pokedeviner"
            }
        }
    },
    {
        name: 'Palworld',
        icon: '/icons/logo_palworld_mini.jpg',
        logo: '/icons/logo_palworld.png',
        slides: shuffleArray(palworldImages),
        buttons: {
            servers: {
                title: "Nos serveurs",
                link: "/serveurs/palworld"
            }
        }
    }
];
---
<div class="w-full">
    <div id="container-carrousel" class="w-full">

        <!-- MAP : Pour chaque jeu dans la variables games -->
        {games.map((game, i) => (

                <div class="carrousel-game w-screen hidden overflow-hidden"
                     data-game={i}>

                    <!-- Image de fond du carrousel -->
                    <div class="relative w-screen h-screen overflow-hidden" id={`carousel-${i}`}>
                        {game.slides.map((src, j) => (
                            <!-- Image du carrousel -->
                                <Image
                                        src={src.path}
                                        alt={`${game.name} slide ${j + 1}`}
                                        class={`carousel-slide absolute top-0 left-0 w-screen h-full object-cover 
                                        transition-all duration-500 ease-in-out opacity-0 scale-105 translate-x-4`}
                                        id="carousel-slide"
                                        loading="lazy"
                                        width={120}
                                        height={120}
                                />
                            <!-- Crédit de l'image -->
                                <div class="carousel-auteur absolute bottom-4 left-4 text-white text-sm bg-black/40 px-3 py-1 rounded opacity-0 transition-opacity duration-500">
                                    <p>{src.attribution}</p>
                                </div>
                        ))}

                        <!-- Container Logo des jeux -->
                        <div class="flex justify-center w-full">
                            <div class="bg-gradient-to-r from-brown-900/80 to-brown-700/80 text-white p-8 rounded-xl
                            absolute top-1/4 transform -translate-y-1/2 transition-all duration-500 opacity-0">

                                <Image src={game.logo} alt={game.name} class="object-contain"
                                       width={500} height={500}/>

                            </div>
                        </div>

                        <!-- Container Icone des jeux -->
                        <div class="absolute top-1/2 transform -translate-y-1/2 flex justify-center w-full gap-8">
                            {games.map((g, idx) => (
                                    <div
                                            class={`game-icon text-6xl cursor-pointer transform transition duration-300`}
                                            data-index={idx}
                                    >
                                        <!-- Icone des jeux -->
                                        <Image
                                                src={g.icon}
                                                alt={g.name}
                                                class="w-20 h-20 object-contain rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300"
                                                width={150}
                                                height={150}
                                        />
                                    </div>
                            ))}
                        </div>

                        <!-- Boutons -->
                        <div class="absolute top-3/4 transform -translate-y-1/2 w-full flex flex-wrap justify-center gap-4 sm:gap-6 z-10 px-4">
                            {Object.values(game.buttons).map((btn) => (
                                    <a
                                            href={btn.link}
                                            class="text-white border border-white/90 font-semibold py-3 px-8 text-lg rounded-lg shadow-md backdrop-blur-md transition-all duration-300 hover:bg-black/20 bg-black/40"
                                    >
                                        {btn.title}
                                    </a>
                            ))}
                        </div>
                    </div>
                </div>
        ))}
    </div>
</div>

<script type="module">
    let intervals = [];

    window.addEventListener("DOMContentLoaded", () => {
        const carousels = document.querySelectorAll('.carrousel-game');
        const icons = document.querySelectorAll('.game-icon');

        const clearIntervals = () => {
            intervals.forEach(clearInterval);
            intervals = [];
        };

        const showCarousel = (carousel, direction = 'right') => {
            carousel.classList.remove('hidden');
            const slides = carousel.querySelectorAll('.carousel-slide');
            const slidesAuteurs = carousel.querySelectorAll('.carousel-auteur');
            const titleContainer = carousel.querySelector('.bg-gradient-to-r');

            slides.forEach((slide) => {
                // Reset all slides
                slide.classList.remove(
                    'opacity-100', 'scale-100', 'translate-x-0',
                    'opacity-0', 'scale-105', 'translate-x-4', '-translate-x-4'
                );
                slide.classList.add('opacity-0', 'scale-105', direction === 'right' ? 'translate-x-4' : '-translate-x-4');
            });

            // Show first slide
            setTimeout(() => {
                slides[0].classList.remove('opacity-0', 'scale-105', 'translate-x-4', '-translate-x-4');
                slides[0].classList.add('opacity-100', 'scale-100', 'translate-x-0');

                if (slidesAuteurs[0]) {
                    slidesAuteurs[0].classList.remove('opacity-0');
                    slidesAuteurs[0].classList.add('opacity-100');
                }

            }, 50);

            if (titleContainer) {
                setTimeout(() => {
                    titleContainer.style.opacity = '1';
                    titleContainer.style.transform = 'translateY(0)';
                }, 300);
            }

            startCarousel(carousel); // start the carousel after it's shown
        };

        const hideCarousels = (direction) => {
            carousels.forEach(carousel => {
                const slides = carousel.querySelectorAll('.carousel-slide');
                const slidesAuteurs = carousel.querySelectorAll('.carousel-auteur');
                const titleContainer = carousel.querySelector('.bg-gradient-to-r');

                slidesAuteurs.forEach((auteur) => {
                    auteur.classList.remove('opacity-100');
                    auteur.classList.add('opacity-0');
                });

                slides.forEach(slide => {
                    slide.classList.remove('opacity-100', 'scale-100', 'translate-x-0');
                    slide.classList.add('opacity-0', 'scale-105', direction === 'right' ? '-translate-x-4' : 'translate-x-4');
                });

                if (titleContainer) {
                    titleContainer.style.opacity = '0';
                    titleContainer.style.transform = 'translateY(-20px)';
                }

                setTimeout(() => {
                    carousel.classList.add('hidden');
                }, 300);
            });
        };

        const switchToGame = (gameIndex, currentCarousel) => {
            if (currentCarousel === carousels[gameIndex]) return;

            const direction = gameIndex > parseInt(currentCarousel.dataset.game) ? 'right' : 'left';

            clearIntervals();
            hideCarousels(direction);

            setTimeout(() => {
                showCarousel(carousels[gameIndex], direction);
            }, 300);
        };

        icons.forEach((icon) => {
            icon.addEventListener('click', (e) => {
                const gameIndex = parseInt(e.currentTarget.dataset.index);
                const currentCarousel = document.querySelector('.carrousel-game:not(.hidden)');
                switchToGame(gameIndex, currentCarousel);
            });
        });

        const startCarousel = (carousel) => {
            const slides = carousel.querySelectorAll('.carousel-slide');
            const auteurs = carousel.querySelectorAll('.carousel-auteur');
            if (slides.length < 2) return;

            let current = 0;

            const interval = setInterval(() => {
                // Masquer l'ancienne image et son auteur
                slides[current].classList.remove('opacity-100', 'scale-100', 'translate-x-0');
                slides[current].classList.add('opacity-0', 'scale-105', 'translate-x-4');

                if (auteurs[current]) {
                    auteurs[current].classList.remove('opacity-100');
                    auteurs[current].classList.add('opacity-0');
                }

                current = (current + 1) % slides.length;

                // Afficher la nouvelle image et son auteur
                setTimeout(() => {
                    slides[current].classList.remove('opacity-0', 'scale-105', 'translate-x-4');
                    slides[current].classList.add('opacity-100', 'scale-100', 'translate-x-0');

                    if (auteurs[current]) {
                        auteurs[current].classList.remove('opacity-0');
                        auteurs[current].classList.add('opacity-100');
                    }
                }, 50);
            }, 5000);

            intervals.push(interval);
        };


        // Init style for all titles
        document.querySelectorAll('.bg-gradient-to-r').forEach(container => {
            container.style.transition = 'all 0.5s ease-out';
            container.style.transform = 'translateY(-20px)';
            container.style.opacity = '0';
        });

        // Show first carousel
        showCarousel(carousels[0], 'right');
    });
</script>
