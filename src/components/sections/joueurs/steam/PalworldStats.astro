---
// PalworldStats.astro : section Palworld de la page joueur Steam (même présentation que la page Minecraft)
import TransitionSection from "../../common/transitions/TransitionSection.astro";
import {formatNumber} from "../../../../formater/NumberFormater";
import {slugify} from "../../../../formater/ServeurFormater";
import {PALDB_ICON_URL} from "../../../../utils/constantes";
import type {PalworldCountType, PalworldStatsType} from "../../../../types/PalworldStatsType";

interface Props {
    stats: PalworldStatsType[];
    playername: string;
    prefixe: string;
}

const {stats, playername, prefixe} = Astro.props;

// Icône d'un Pal (les variantes boss partagent l'icône de l'espèce de base)
const palIcon = (species: string) => `${PALDB_ICON_URL}T_${species.replace(/^BOSS_/, "")}_icon_normal.webp`;

const serverName = (stat: PalworldStatsType) => stat.expand?.server?.name ?? "Serveur inconnu";
const sum = (pick: (stat: PalworldStatsType) => number | undefined) =>
    stats.reduce((acc, stat) => acc + (pick(stat) || 0), 0);

// Colonnes du tableau de progression
const progressionColumns: { label: string, pick: (stat: PalworldStatsType) => number }[] = [
    {label: "Captures", pick: s => s.nb_catch_pal},
    {label: "Espèces", pick: s => s.species_captured},
    {label: "Quêtes", pick: s => s.completed_quests},
    {label: "Technologies", pick: s => s.unlocked_technologies},
    {label: "Boss", pick: s => s.tower_boss_defeated},
    {label: "Donjons", pick: s => s.dungeon_clear},
    {label: "Pétroliers", pick: s => s.oilrig_clear},
    {label: "Téléporteurs", pick: s => s.fast_travel_unlocked},
    {label: "Pêche", pick: s => s.fishing_total},
    {label: "Découpes", pick: s => s.pal_butcher_total},
    {label: "Objets créés", pick: s => s.craft_item_total},
];

// Colonnes du tableau de collection (résumé des Pals possédés)
const collectionColumns: { label: string, pick: (stat: PalworldStatsType) => number }[] = [
    {label: "Pals possédés", pick: s => s.pal_summary?.total ?? 0},
    {label: "Espèces", pick: s => s.pal_summary?.unique_species ?? 0},
    {label: "Alphas", pick: s => s.pal_summary?.alpha ?? 0},
    {label: "Chromatiques", pick: s => s.pal_summary?.lucky ?? 0},
    {label: "Éveillés", pick: s => s.pal_summary?.awakened ?? 0},
    {label: "4 passifs", pick: s => s.pal_summary?.four_passives ?? 0},
    {label: "Talents parfaits", pick: s => s.pal_summary?.perfect_talents ?? 0},
];

// Icônes (heroicons) des cartes de statistiques clés
const ICONS = {
    level: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    capture: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
    species: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
    collection: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    boss: "M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9",
    dungeon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7",
};

// Chiffres mis en avant au-dessus des tableaux (tous serveurs confondus)
const keyStats = [
    {title: "Niveau max", value: Math.max(0, ...stats.map(stat => stat.level || 0)), icon: ICONS.level},
    {title: "Pals capturés", value: sum(s => s.nb_catch_pal), icon: ICONS.capture},
    {title: "Espèces capturées", value: Math.max(0, ...stats.map(stat => stat.species_captured || 0)), icon: ICONS.species},
    {title: "Pals possédés", value: sum(s => s.pal_summary?.total), icon: ICONS.collection},
    {title: "Boss de tour", value: sum(s => s.tower_boss_defeated), icon: ICONS.boss},
    {title: "Donjons", value: sum(s => s.dungeon_clear), icon: ICONS.dungeon},
];

// Pal le plus découpé, tous serveurs confondus
const butcherTotals = new Map<string, { species: string, name: string, count: number }>();
stats.forEach(stat => Object.entries(stat.butcher_by_species ?? {}).forEach(([species, value]) => {
    if (!value.name_fr) return;
    const entry = butcherTotals.get(species) ?? {species, name: value.name_fr, count: 0};
    entry.count += value.count;
    butcherTotals.set(species, entry);
}));
const mostButchered = [...butcherTotals.values()].sort((a, b) => b.count - a.count)[0];

// Captures et découpes par espèce sur un serveur
const topPalsOf = (stat: PalworldStatsType) => {
    const palCounts = new Map<string, { species: string, name: string, captures: number, butcher: number }>();
    const addPalCounts = (record: Record<string, PalworldCountType> | null, key: "captures" | "butcher") =>
        Object.entries(record ?? {}).forEach(([species, value]) => {
            if (!value.name_fr) return;
            const entry = palCounts.get(species) ?? {species, name: value.name_fr, captures: 0, butcher: 0};
            entry[key] += value.count;
            palCounts.set(species, entry);
        });
    addPalCounts(stat.capture_by_species, "captures");
    addPalCounts(stat.butcher_by_species, "butcher");
    return [...palCounts.values()]
        .sort((a, b) => b.captures - a.captures || b.butcher - a.butcher)
        .slice(0, 15);
};

// Boss vaincus sur un serveur : les variantes de difficulté (Normal, Hard...) partagent le même nom, on les additionne
const bossesOf = (stat: PalworldStatsType) => {
    const bossCounts = new Map<string, { name: string, type: string, count: number }>();
    const addBossCounts = (record: Record<string, PalworldCountType> | null, type: string) =>
        Object.values(record ?? {}).forEach(value => {
            if (!value.name_fr) return;
            const key = `${type}|${value.name_fr}`;
            const entry = bossCounts.get(key) ?? {name: value.name_fr, type, count: 0};
            entry.count += value.count;
            bossCounts.set(key, entry);
        });
    addBossCounts(stat.tower_boss_defeats, "Tour");
    addBossCounts(stat.raid_boss_defeats, "Raid");
    return [...bossCounts.values()].sort((a, b) => b.count - a.count);
};

// Équipe et classements par serveur, affichés selon le serveur choisi
const servers = stats
    .map(stat => ({
        id: stat.server,
        name: serverName(stat),
        team: [...(stat.pal_team ?? [])].sort((a, b) => a.slot_index - b.slot_index),
        topPals: topPalsOf(stat),
        bosses: bossesOf(stat),
    }))
    .filter(server => server.team.length > 0 || server.topPals.length > 0 || server.bosses.length > 0);
---

<TransitionSection title={`%Statistiques% ![/icons/logo_palworld.png] ${prefixe} #${playername}#`}/>

{stats.length === 0 ? (
    <p style="padding: 5em;">Ce joueur n’a pas de données.</p>
) : (
    <div class="palworld-tables">
        <div class="key-stats">
            {keyStats.map(card => (
                <div class="key-stat-card">
                    <span class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={card.icon}/>
                        </svg>
                    </span>
                    <span class="card-title">{card.title}</span>
                    <span class="card-value">{formatNumber(card.value || 0)}</span>
                </div>
            ))}

            {mostButchered && (
                <div class="key-stat-card featured-pal">
                    <img class="featured-portrait" src={palIcon(mostButchered.species)} alt={mostButchered.name}
                         width="72" height="72" loading="lazy" onerror="this.style.visibility='hidden'"/>
                    <div class="featured-text">
                        <span class="card-title">Pal le plus découpé</span>
                        <span class="card-value">{mostButchered.name}</span>
                        <span class="featured-detail">{formatNumber(mostButchered.count)} découpes</span>
                    </div>
                </div>
            )}
        </div>

        <div class="ranking-table-container">
            <table class="ranking-table">
                <thead class="ranking-thead">
                <tr>
                    <th class="ranking-th">Nom du serveur</th>
                    {progressionColumns.map(column => <th class="ranking-th">{column.label}</th>)}
                </tr>
                </thead>
                <tbody>
                {stats.map((stat, index) => (
                    <tr class={index % 2 === 0 ? "ranking-tr-even" : "ranking-tr-odd"}>
                        <td class="ranking-td server-cell">
                            <img src="/icons/logo_palworld_mini.jpg" alt="Palworld" width="24" height="24"/>
                            <a class="ranking-link" href={`/serveurs/palworld/${slugify(serverName(stat))}`}>{serverName(stat)}</a>
                        </td>
                        {progressionColumns.map(column => <td class="ranking-td">{formatNumber(column.pick(stat) || 0)}</td>)}
                    </tr>
                ))}
                <tr class="ranking-thead">
                    <td class="ranking-td">Total tous serveurs</td>
                    {progressionColumns.map(column => <td class="ranking-td">{formatNumber(sum(column.pick))}</td>)}
                </tr>
                </tbody>
            </table>
        </div>

        <div class="ranking-table-container">
            <table class="ranking-table">
                <thead class="ranking-thead">
                <tr>
                    <th class="ranking-th">Collection</th>
                    <th class="ranking-th">Niveau</th>
                    <th class="ranking-th">Guilde</th>
                    {collectionColumns.map(column => <th class="ranking-th">{column.label}</th>)}
                    <th class="ranking-th">Niveau moyen</th>
                </tr>
                </thead>
                <tbody>
                {stats.map((stat, index) => (
                    <tr class={index % 2 === 0 ? "ranking-tr-even" : "ranking-tr-odd"}>
                        <td class="ranking-td server-cell">
                            <img src="/icons/logo_palworld_mini.jpg" alt="Palworld" width="24" height="24"/>
                            {serverName(stat)}
                        </td>
                        <td class="ranking-td">{stat.level}</td>
                        <td class="ranking-td wrap-cell">{stat.guild_name || "—"}</td>
                        {collectionColumns.map(column => <td class="ranking-td">{formatNumber(column.pick(stat))}</td>)}
                        <td class="ranking-td">{Math.round(stat.pal_summary?.average_level ?? 0)}</td>
                    </tr>
                ))}
                <tr class="ranking-thead">
                    <td class="ranking-td">Total tous serveurs</td>
                    <td class="ranking-td">{Math.max(...stats.map(stat => stat.level || 0))}</td>
                    <td class="ranking-td">—</td>
                    {collectionColumns.map(column => <td class="ranking-td">{formatNumber(sum(column.pick))}</td>)}
                    <td class="ranking-td">—</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
)}

{servers.length > 0 && (
    <>
        <div class="palworld-servers">
            {/* Choix du serveur (mêmes boutons que la page classements) : uniquement s'il y en a plusieurs */}
            {servers.length > 1 && (
                <div class="server-selector">
                    {servers.map((server, index) => (
                        <button type="button" data-server={server.id}
                                class={`ranking-filter-button ${index === 0 ? "active" : "inactive"}`}>
                            {server.name}
                        </button>
                    ))}
                </div>
            )}

            {servers.map(({id, name, team, topPals, bosses}, index) => (
                <div class="server-block" data-server={id} hidden={index > 0}>
                    {team.length > 0 && (
                        <>
                            <TransitionSection title={`Équipe ${prefixe} #${playername}# sur ${name}`} invertedBackground/>

                            {/* Une vignette par Pal, mêmes classes que les vignettes des serveurs */}
                            <div class="pal-team">
                                {team.map(pal => (
                                    <div class="server-card pal-vignette">
                                        <div class="server-card-image pal-vignette-image"
                                             style={`--server-banner: url('/banner/palworld/${slugify(name)}.webp')`}>
                                            <img src={palIcon(pal.species)} alt={pal.species_name_fr} loading="lazy"
                                                 onerror="this.style.visibility='hidden'"/>
                                        </div>

                                        <div class="server-card-content">
                                            <h3>{pal.nickname || pal.species_name_fr}</h3>
                                            <p class="server-card-description">
                                                {pal.species_name_fr} · Rang {pal.rank}
                                                <br/>
                                                PV {pal.talent_hp} · ATK {pal.talent_attack} · DEF {pal.talent_defense}
                                                {pal.passives_fr?.length > 0 && (
                                                    <>
                                                        <br/>
                                                        <span class="pal-passives">{pal.passives_fr.join(" · ")}</span>
                                                    </>
                                                )}
                                            </p>

                                            <div class="server-card-footer">
                                                <span class="server-card-badge version">Niv. {pal.level}</span>
                                                {pal.is_alpha && <span class="server-card-badge unactive">Alpha</span>}
                                                {pal.is_lucky && <span class="server-card-badge active">Chromatique</span>}
                                                {pal.awakened && <span class="server-card-badge ip">Éveillé</span>}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </>
                    )}

                    {(topPals.length > 0 || bosses.length > 0) && (
                        <div class="palworld-rankings">
                        {topPals.length > 0 && (
                            <div class="ranking-table-container">
                                <table class="ranking-table">
                                    <thead class="ranking-thead">
                                    <tr>
                                        <th class="ranking-th">#</th>
                                        <th class="ranking-th">Pals les plus capturés</th>
                                        <th class="ranking-th">Captures</th>
                                        <th class="ranking-th">Découpes</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {topPals.map((pal, index) => (
                                        <tr class={index % 2 === 0 ? "ranking-tr-even" : "ranking-tr-odd"}>
                                            <td class="ranking-td">{index + 1}</td>
                                            <td class="ranking-td server-cell">
                                                <img src={palIcon(pal.species)} alt="" width="32" height="32" loading="lazy"
                                                     onerror="this.style.visibility='hidden'"/>
                                                {pal.name}
                                            </td>
                                            <td class="ranking-td">{formatNumber(pal.captures)}</td>
                                            <td class="ranking-td">{formatNumber(pal.butcher)}</td>
                                        </tr>
                                    ))}
                                    </tbody>
                                </table>
                            </div>
                        )}

                        {bosses.length > 0 && (
                            <div class="ranking-table-container">
                                <table class="ranking-table">
                                    <thead class="ranking-thead">
                                    <tr>
                                        <th class="ranking-th">Boss vaincus</th>
                                        <th class="ranking-th">Type</th>
                                        <th class="ranking-th">Victoires</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {bosses.map((boss, index) => (
                                        <tr class={index % 2 === 0 ? "ranking-tr-even" : "ranking-tr-odd"}>
                                            <td class="ranking-td boss-cell">{boss.name}</td>
                                            <td class="ranking-td">{boss.type}</td>
                                            <td class="ranking-td">{formatNumber(boss.count)}</td>
                                        </tr>
                                    ))}
                                    </tbody>
                                </table>
                            </div>
                        )}
                        </div>
                    )}
                </div>
            ))}
        </div>
    </>
)}

<script>
    // Affiche l'équipe et les classements du serveur sélectionné
    document.querySelectorAll<HTMLButtonElement>(".palworld-servers .server-selector button").forEach((button) => {
        button.addEventListener("click", () => {
            const wrapper = button.closest(".palworld-servers");
            if (!wrapper) return;

            wrapper.querySelectorAll<HTMLButtonElement>(".server-selector button").forEach((other) => {
                const isActive = other === button;
                other.classList.toggle("active", isActive);
                other.classList.toggle("inactive", !isActive);
            });

            wrapper.querySelectorAll<HTMLElement>(".server-block").forEach((serverBlock) => {
                serverBlock.hidden = serverBlock.dataset.server !== button.dataset.server;
            });
        });
    });
</script>

<style>
    /* --- TABLEAUX (même rendu que PlayerStatsTable sur la page Minecraft) --- */
    .palworld-tables {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 2rem 1rem;
        text-align: left;
    }

    /* --- STATISTIQUES CLÉS (même rendu que les statistiques Discord) --- */
    .key-stats {
        display: grid;
        /* 6 cartes + la vignette du Pal le plus découpé sur 2 colonnes */
        grid-template-columns: repeat(8, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .key-stat-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        min-width: 0;
        padding: 1.5rem 1rem 1.25rem;
        overflow: hidden;
        text-align: center;
        background-color: var(--server-screen-color-bg-card);
        border: 1px solid var(--server-screen-color-border);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    /* Liseré doré en haut de carte */
    .key-stat-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: linear-gradient(90deg, var(--golden-gradient-shift-1), var(--golden-gradient-shift-2), var(--golden-gradient-shift-3));
    }

    .key-stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--server-screen-color-accent);
    }

    .card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        margin-bottom: 0.35rem;
        border-radius: 50%;
        color: var(--server-screen-color-accent);
        background-color: color-mix(in srgb, var(--server-screen-color-accent) 15%, transparent);
    }

    .card-title {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--server-screen-color-text-muted);
    }

    .card-value {
        font-size: 1.2rem;
        font-weight: bold;
        color: var(--server-screen-color-text-main);
        font-variant-numeric: tabular-nums;
    }

    /* --- CHOIX DU SERVEUR --- */
    .server-selector {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        padding: 2rem 1rem 0;
    }

    .server-block[hidden] {
        display: none;
    }

    .palworld-tables .ranking-th {
        white-space: nowrap;
    }

    /* Plus de colonnes que le tableau Minecraft : marges internes resserrées */
    .palworld-tables .ranking-th,
    .palworld-tables .ranking-td {
        padding: 1rem;
    }

    .server-cell {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .server-cell img {
        object-fit: contain;
        border-radius: 4px;
    }

    .palworld-rankings {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
        gap: 2rem;
        padding: 2rem 1rem;
        text-align: left;
    }

    .boss-cell,
    .wrap-cell {
        white-space: normal;
    }

    /* --- ÉQUIPE : vignettes server-card (styles globaux du site) --- */
    .pal-team {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1.5rem;
        padding: 1rem 1rem 2.5rem;
        margin: 0 1rem;
        text-align: left;
    }

    /* Bannière du serveur assombrie, Pal au premier plan */
    .pal-vignette-image {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 160px;
        background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), var(--server-banner) center / cover;
    }

    .server-card .pal-vignette-image img {
        width: 112px;
        height: 112px;
        object-fit: contain;
        filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.5));
    }

    .pal-passives {
        font-style: italic;
    }

    /* Le pied de vignette est masqué sous 800px par défaut : on garde le niveau visible */
    .pal-vignette .server-card-footer {
        display: flex;
    }

    @media (max-width: 1400px) {
        .pal-team {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 1100px) {
        .key-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .featured-pal {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 900px) {
        .palworld-rankings {
            grid-template-columns: minmax(0, 1fr);
        }

        .pal-team {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .key-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .pal-team {
            grid-template-columns: minmax(0, 1fr);
            margin: 0;
        }
    }
</style>
