---
// SteamGameCategory.astro : zone repliable regroupant toutes les sections d'un jeu sur la page joueur Steam
interface Props {
    id: string;
    name: string;
    logo: string;
    banner: string;
    // Déplié au chargement (ex. le joueur n'a joué qu'à ce jeu)
    open?: boolean;
}

const {id, name, logo, banner, open = true} = Astro.props;
---

<details id={id} class="game-category" open={open}>
    <summary class="game-category-header" style={`--game-banner: url('${banner}')`}>
        <img class="game-category-logo" src={logo} alt={name}/>
        <span class="game-category-toggle">
            <span class="toggle-label"></span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M7 10l5 5 5-5H7z" fill="currentColor"/>
            </svg>
        </span>
    </summary>

    <div class="game-category-content">
        <slot/>
    </div>
</details>

<script>
    // Un lien vers la catégorie (ex. badges du profil) la déplie si elle était repliée
    const openFromHash = () => {
        const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
        if (target instanceof HTMLDetailsElement) target.open = true;
    };
    window.addEventListener("hashchange", openFromHash);
    openFromHash();

    // Clic sur un lien déjà présent dans l'URL : pas de hashchange, on déplie quand même
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", () => {
            const target = document.getElementById(link.hash.slice(1));
            if (target instanceof HTMLDetailsElement) target.open = true;
        });
    });
</script>

<style>
    .game-category {
        scroll-margin-top: 6rem;
    }

    /* Bandeau du jeu : bannière assombrie, logo au centre */
    .game-category-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 150px;
        padding: 0 1.5rem;
        cursor: pointer;
        list-style: none;
        user-select: none;
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), var(--game-banner) center / cover;
        border-top: 2px solid var(--component-transition-outline-color);
        border-bottom: 2px solid var(--component-transition-outline-color);
    }

    .game-category-header::-webkit-details-marker {
        display: none;
    }

    .game-category-logo {
        max-height: 90px;
        max-width: 60%;
        object-fit: contain;
        filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6));
    }

    /* Bouton replier / déplier (même rendu que le bouton de l'équipe Pokémon) */
    .game-category-toggle {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--color-white);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .game-category-toggle svg {
        width: 40px;
        height: 40px;
        padding: 9px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    }

    .game-category-header:hover .game-category-toggle svg {
        background: var(--color-gold);
        color: var(--color-black);
    }

    .game-category[open] .game-category-toggle svg {
        transform: rotate(180deg);
    }

    .toggle-label::before {
        content: "Déplier";
    }

    .game-category[open] .toggle-label::before {
        content: "Replier";
    }

    .game-category-header:focus-visible {
        outline: 2px solid var(--color-gold);
        outline-offset: -4px;
    }

    @media (max-width: 600px) {
        .game-category-header {
            height: 110px;
        }

        .game-category-logo {
            max-height: 60px;
            max-width: 55%;
        }

        .game-category-toggle {
            right: 1rem;
        }

        .toggle-label {
            display: none;
        }
    }
</style>
