---
import type { PokedevinerStatType } from "../../../types/PokedevinerStatsType";
import { formatDate } from "../../../formater/DateFormater";

interface Props {
    stats?: PokedevinerStatType[];
}

const { stats = [] } = Astro.props;
const hasStats = stats.length > 0;

// Helper to determine status
const isSuccess = (stat: PokedevinerStatType) => stat.success_at && stat.success_at !== "";
---

<div class="poke-stats-container">
    {hasStats ? (
        <div class="poke-stats-grid">
            {stats.map((stat) => (
                <div class={`poke-card ${isSuccess(stat) ? 'success' : 'failed'}`}>
                    <div class="poke-card-header">
                        <div class="poke-icon">
                            {isSuccess(stat) ? (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="icon-success">
                                    <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
                                </svg>
                            ) : (
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="icon-failed">
                                    <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm-1.72 6.97a.75.75 0 10-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 101.06 1.06L12 13.06l1.72 1.72a.75.75 0 101.06-1.06L13.06 12l1.72-1.72a.75.75 0 10-1.06-1.06L12 10.94l-1.72-1.72z" clip-rule="evenodd" />
                                </svg>
                            )}
                        </div>
                        <h3 class="pokemon-name">{stat.pokemon_name}</h3>
                    </div>
                    
                    <div class="poke-card-body">
                        <div class="stat-row">
                            <span class="stat-label">Essais</span>
                            <span class="stat-value highlight">{stat.nb_try}</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Début</span>
                            <span class="stat-value">{formatDate(stat.start_at)}</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">Réussite</span>
                            <span class="stat-value">{isSuccess(stat) ? formatDate(stat.success_at) : "-"}</span>
                        </div>
                        
                        {stat.pokemon_try_list && Array.isArray(stat.pokemon_try_list) && stat.pokemon_try_list.length > 0 && (
                            <details class="poke-tries-details">
                                <summary>Voir les essais ({stat.pokemon_try_list.length})</summary>
                                <ul class="poke-tries-list">
                                    {stat.pokemon_try_list.map((tryName: string, index: number) => (
                                        <li>
                                            <span class="try-number">#{index + 1}</span>
                                            <span class="try-name">{tryName}</span>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        )}
                    </div>
                </div>
            ))}
        </div>
    ) : (
        <div class="empty-state">
            <p>Aucune partie de Pokedeviner jouée pour le moment !</p>
        </div>
    )}
</div>

<style>
    /* --- VARIABLES --- */
    :root {
        --poke-card-bg: var(--server-screen-color-bg-card, #ffffff);
        --poke-card-border: var(--server-screen-color-border, #e5e7eb);
        --poke-text-main: var(--server-screen-color-text-main, #1f2937);
        --poke-text-muted: var(--server-screen-color-text-muted, #6b7280);
        --poke-success: #10b981;
        --poke-success-bg: rgba(16, 185, 129, 0.1);
        --poke-failed: #ef4444;
        --poke-failed-bg: rgba(239, 68, 68, 0.1);
        --poke-card-radius: 1rem;
        --poke-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --poke-shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .poke-stats-container {
        width: 100%;
        margin-top: 1rem;
    }

    /* --- GRILLE --- */
    .poke-stats-grid {
        display: grid;
        gap: 1.5rem;
        padding: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }

    /* --- CARTE --- */
    .poke-card {
        background-color: var(--poke-card-bg);
        border: 2px solid var(--poke-card-border);
        border-radius: var(--poke-card-radius);
        padding: 1.25rem;
        box-shadow: var(--poke-shadow);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        z-index: 1;
    }

    .poke-card:has(details[open]), .poke-card:hover {
        z-index: 10;
    }

    .poke-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        border-top-left-radius: calc(var(--poke-card-radius) - 2px);
        border-top-right-radius: calc(var(--poke-card-radius) - 2px);
    }

    .poke-card.success::before {
        background-color: var(--poke-success);
    }

    .poke-card.failed::before {
        background-color: var(--poke-failed);
    }

    .poke-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--poke-shadow-hover);
    }

    /* --- EN-TÊTE --- */
    .poke-card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .poke-icon {
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .poke-card.success .poke-icon {
        background-color: var(--poke-success-bg);
        color: var(--poke-success);
    }

    .poke-card.failed .poke-icon {
        background-color: var(--poke-failed-bg);
        color: var(--poke-failed);
    }

    .poke-icon svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .pokemon-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--poke-text-main);
        margin: 0;
        text-transform: capitalize;
    }

    /* --- CORPS --- */
    .poke-card-body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 0;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }

    .stat-label {
        color: var(--poke-text-muted);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stat-value {
        color: var(--poke-text-main);
        font-weight: 600;
    }

    .stat-value.highlight {
        background-color: var(--server-screen-color-accent, #3b82f6);
        color: white;
        padding: 0.2rem 0.6rem;
        border-radius: 1rem;
        font-size: 0.85rem;
    }

    /* --- DETAILS / ESSAIS --- */
    .poke-tries-details {
        margin-top: 0.5rem;
        position: relative;
    }

    .poke-tries-details summary {
        padding: 0.75rem 1rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--poke-text-main);
        cursor: pointer;
        user-select: none;
        background-color: var(--poke-card-bg);
        border: 1px solid var(--poke-card-border);
        border-radius: 0.5rem;
        transition: background-color 0.2s ease, border-radius 0.2s ease;
    }

    .poke-tries-details[open] summary {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom-color: transparent;
    }

    .poke-tries-details summary:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .poke-tries-list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 150px;
        overflow-y: auto;
        
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--poke-card-bg);
        z-index: 10;
        border: 1px solid var(--poke-card-border);
        border-top: none;
        border-bottom-left-radius: 0.5rem;
        border-bottom-right-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .poke-tries-list li {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        display: flex;
        gap: 0.75rem;
        border-bottom: 1px solid var(--poke-card-border);
    }

    .poke-tries-list li:last-child {
        border-bottom: none;
    }

    .try-number {
        color: var(--poke-text-muted);
        font-weight: 500;
        font-family: monospace;
    }

    .try-name {
        color: var(--poke-text-main);
        text-transform: capitalize;
    }

    /* --- EMPTY STATE --- */
    .empty-state {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        text-align: center;
        background: rgba(0, 0, 0, 0.02);
        border-radius: var(--poke-card-radius);
        border: 2px dashed var(--poke-card-border);
        margin: 1rem;
    }

    .empty-state p {
        font-size: 1.1rem;
        color: var(--poke-text-muted);
        font-weight: 500;
        margin: 0;
    }

    /* Dark mode adaptation if the site uses one */
    @media (prefers-color-scheme: dark) {
        .empty-state {
            background: rgba(255, 255, 255, 0.02);
        }
    }
</style>
