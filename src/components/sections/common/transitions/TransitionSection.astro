---
import { parseTitle } from "../../../../utils/prettyloutre.ts";

interface Props {
    title: string;
    invertedBackground?: boolean;
}

const parsedTitle = parseTitle(Astro.props.title ?? "");
const { invertedBackground = false } = Astro.props;
---

<div class={`default-transition-container ${invertedBackground ? "no-background-transition-container" : ""}`}>
    <h1 set:html={parsedTitle} style="line-height: 1.6em"></h1>
    <slot />
</div>
