---
interface Props {
    value: number;
    max?: number;
    color?: string;
    height?: string;
}

const {
    value,
    max = 255,
    color = "#FFCC00",
    height = "1rem"
} = Astro.props;

const percentage = Math.min((value / max) * 100, 100);
---

<div class="stat-container" style={`--height: ${height};`}>
    <div
            class="stat-bar"
            style={`width: ${percentage}%; background-color: ${color};`}
    ></div>
</div>

<style>
    .stat-container {
        width: 100%;
        height: var(--height);
        border-radius: 999px;
        overflow: hidden;
        display: flex;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.1);
        min-width: 0;
    }

    .stat-bar {
        height: 100%;
        border-radius: 999px;
        transition: width 0.5s ease-out;
        flex-shrink: 0;
    }

    /* -------- MOBILE -------- */

    @media (max-width: 600px) {
        .stat-container {
            height: calc(var(--height) * 0.8);
        }
    }

</style>