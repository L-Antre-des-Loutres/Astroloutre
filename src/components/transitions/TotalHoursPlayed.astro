---
import {Image} from 'astro:assets';
import ServersTextImage from "../../assets/titles/serveurs.webp";
import {formatMinecraftPlayTime} from "../../formater/MinecraftPlayTimeFormater.ts";
import {formatDecimalHours} from "../../formater/DecimalHoursFormater.ts";

let totalHours: Promise<number> | number = 0;

// Récupération des heures Minecraft
const response = await fetch('https://otterlyapi.antredesloutres.fr/api/joueurs/stats-serveur/serveurs-total-playtime');
if (response.ok) {
    const json = await response.json();
    totalHours = formatMinecraftPlayTime(Number(json?.data?.[0]?.total_hours || 0));
}

// Récupération des heures Palworld
const responsePalworld = await fetch('https://otterlyapi.antredesloutres.fr/api/palworld/stats/total-hours');
if (responsePalworld.ok) {
    const json = await responsePalworld.json();
    totalHours += await formatDecimalHours(json?.data?.[0]?.total_hours) || 0;
}
---

<div class="total-hours-container">
    <p>
        Un total de plus de <span class="textColorGradientShift textAnimatedUnderlineGradient">{totalHours} heures</span> joué sur nos
        <span class="inline-image">
            <Image src={ServersTextImage} alt="serveurs" width={1000} height={50} />
        </span>
        !
    </p>
</div>

<style>

    /* ============================
        VARIABLES GLOBALES
    ============================ */
    :root {
        /* Couleurs */

        /* Éléments */
        --height-default: 10em;
        --height-sm: 15em;
        --height-xs: 18em;

        --font-size-main: 2rem;
        --watermark-size: 5rem;

        --underline-height: 3px;
    }

    /* ============================
        PRINCIPAL
    ============================ */
    .total-hours-container {
        display: flex;
        padding: 1rem;

        justify-content: center;
        align-items: center;

        height: var(--height-default);

        color: var(--component-transition-text-color);
        background-color: var(--component-transition-background-color);
        border: 2px solid var(--component-transition-outline-color);

        text-align: center;

        overflow: hidden;
    }

    @media (max-width: 500px) {
        .total-hours-container {
            height: var(--height-sm);
        }
    }

    @media (max-width: 300px) {
        .total-hours-container {
            height: var(--height-xs);
        }
    }

    .total-hours-container p {
        position: relative;
        z-index: 1;
        font-size: var(--font-size-main);
    }

    /* ============================
        ANIMATIONS
    ============================ */



    .total-hours-container .inline-image img {
        display: inline;
        height: 1.1em;
        width: auto;
        vertical-align: middle;
        transform: translateY(-5px);
    }
</style>
