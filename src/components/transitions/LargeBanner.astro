---
import { parseTitle } from "../../utils/prettyloutre.ts";
import { Image } from 'astro:assets';

interface Props {
    title: string;
}

const parsedTitle = parseTitle(Astro.props.title ?? "");
---

<div class="default-transition-container" id="large-banner">
    <h1 set:html={parsedTitle}></h1>
    <slot />
</div>

<style>
    #large-banner {
        min-height: 10em;
    }
    #large-banner h1 {
        font-size: var(--font-size-biggest-title);
    }
</style>