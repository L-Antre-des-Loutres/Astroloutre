<style>
    * {
        color: white;
        box-sizing: border-box;
    }

    .wiki-page-wrapper {
        display: grid;
        grid-template-columns: 1fr 3fr 1fr;
        gap: 20px;
    }

    .wiki-sidebar-left,
    .wiki-sidebar-right {
        padding: 5px;
    }

    .wiki-main-container {
        width: 100%;
        max-width: 3500px;
        margin: 0 auto 2rem;
        padding: 0 1rem;
        min-width: 0;
    }

    @media (max-width: 1450px) {
        .wiki-page-wrapper {
            grid-template-columns: 1fr;
            padding: 0 10px;
        }

        .wiki-sidebar-left,
        .wiki-sidebar-right {
            display: none;
        }
    }

    .wiki-nav-container {
        margin: 0 16px;
        padding: 1.5rem 1rem;
        border: 5px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        height: fit-content;
    }

    .wiki-nav-section {
        margin-bottom: 2rem;
    }

    .wiki-nav-title {
        font-size: 0.95rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        color: white;
    }

    .wiki-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .wiki-nav-item {
        margin-bottom: 0.4rem;
    }

    .wiki-nav-link {
        display: block;
        padding: 0.4rem 0.6rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        color: mintcream;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .wiki-nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #92aea2;
    }

    .wiki-message-right {
        padding: 1.5rem 1rem;
        background-color: rgba(155, 255, 155, 0.2);
        border-radius: 10px;
        height: fit-content;
    }

    .wiki-ad-toggle-button {
        margin-top: 1rem;
        padding: 0.5rem 0.8rem;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        background-color: rgba(255, 255, 255, 0.15);
        color: white;
        transition: background-color 0.2s ease, transform 0.1s ease;
        width: 100%;
    }

    .wiki-ad-toggle-button:hover {
        background-color: rgba(255, 255, 255, 0.25);
    }

    .wiki-ad-toggle-button:active {
        transform: scale(0.97);
    }

    .pkmn-wiki-ad {
        background-image: url("https://the-source.net/wp-content/uploads/Ad-Placeholder-250x250.jpg");
    }
</style>

<script>
    const adContainer = document.querySelector(".pkmn-wiki-ad");
    const toggleButton = document.getElementById("wikiAdToggleBtn");

    function updateAdState() {
        const adsDisabled = localStorage.getItem("wiki-ads-disabled");

        if (adsDisabled === "true") {
            adContainer.style.display = "none";
            toggleButton.textContent = "Réactiver";
        } else {
            adContainer.style.display = "block";
            toggleButton.textContent = "Désactiver";
        }
    }

    toggleButton.addEventListener("click", () => {
        const adsDisabled = localStorage.getItem("wiki-ads-disabled") === "true";
        localStorage.setItem("wiki-ads-disabled", (!adsDisabled).toString());
        updateAdState();
    });

    updateAdState();
</script>