---
import React from "react";
import UserClassementReactComponent from "./UserClassement.tsx";
import type {
    DiscordUserType,
    DiscordUserStatsType,
} from "../../../../types/UtilisateurDiscordType.ts";
import {ApiFetcher} from "../../../../utils/API/apiFetcher";

// Fetch des utilisateurs
const users = await ApiFetcher.getAllRecords<DiscordUserType>("discord_users");

// Fetch des statistiques des utilisateurs depuis l'API
const stats = await ApiFetcher.getAllRecords<DiscordUserStatsType>("discord_user_stats");
---

<UserClassementReactComponent
        client:load
        jeu="discord"
        users={users}
        stats={stats}
/>
