---
import PokeSilhouetteClassementReactComponent from "./PokeSilhouetteClassement.tsx";
import type {DiscordUserType} from "../../../../../types/UtilisateurDiscordType.ts";
import type {PokeSilhouetteScoreType, PokeSilhouetteGameType} from "../../../../../types/PokeSilhouetteStatsType.ts";
import {ApiFetcher} from "../../../../../utils/API/apiFetcher";
import {DISCORD_USERS, POKE_SILHOUETTE_GAMES, POKE_SILHOUETTE_SCORES} from "../../../../../utils/constantes.ts";

// Fetch des utilisateurs Discord
const rawUsers = await ApiFetcher.getAllRecords<DiscordUserType>(DISCORD_USERS);

// Conversion en POJO pur
const users = rawUsers.map(u => ({
    id: u.id,
    username: u.username,
    discord_tag: u.discord_tag,
    avatar_url: u.avatar_url,
    roles: u.roles || []
} as DiscordUserType));

// Fetch des games Poke-Silhouette
const games = await ApiFetcher.getAllRecords<PokeSilhouetteGameType>(POKE_SILHOUETTE_GAMES, {
    fields: "id,started_at,created"
});

// Fetch des scores Poke-Silhouette
const scores = await ApiFetcher.getAllRecords<PokeSilhouetteScoreType>(POKE_SILHOUETTE_SCORES, {
    fields: "discord_user,rank,elapsed_ms,created,game"
});
---

<PokeSilhouetteClassementReactComponent
        client:load
        users={users}
        scores={scores}
        games={games}
/>
