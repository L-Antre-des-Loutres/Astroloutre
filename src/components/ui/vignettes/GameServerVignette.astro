---
interface Props {
    image: string;
    image_alt: string;
    title: string;
    paragraph: string;
    version: string;
    jeu: string;
    type: string;
    actif?: boolean;
    // Adresse fournie par la page (null = pas d'adresse à afficher)
    ip?: string | null;
}

const { image, image_alt, title, paragraph, version, jeu, type, actif = false, ip } = Astro.props;

// Calcul de l'IP pour simplifier le template, sauf si la page fournit déjà l'adresse
const ipAddress = "ip" in Astro.props ? ip : jeu === "palworld" ? "antredesloutres.fr:8211" : type === "primary" ? "antredesloutres.fr" : "secondaire.antredesloutres.fr";
---

<div class="server-card">
    <div class="server-card-image">
        {image && <img src={image} alt={image_alt ?? 'Image'}/>}
        <div class="overlay"></div>
    </div>

    <div class="server-card-content">
        <h3>{title ?? 'Sans titre'}</h3>
        <p class="server-card-description">{paragraph ?? 'Aucune description.'}</p>

        <div class="server-card-footer">
            <span class="server-card-badge version">Version {version}</span>
            {ipAddress && <span class="server-card-badge ip">{ipAddress}</span>}
            {actif ? (
                    <span class="server-card-badge active">Activé</span>
            ) : (
                    <span class="server-card-badge unactive">Désactivé</span>
            )}
        </div>
    </div>
</div>
