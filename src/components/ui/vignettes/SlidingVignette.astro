---
import { parseTitle } from "../../../utils/prettyloutre.ts";

interface Props {
    image: string;
    image_alt: string;
    title: string;
    paragraph: string;
    card_link: string;
    margin?: string;
    transform_anim?: boolean;
}

const {
    image,
    image_alt,
    title,
    paragraph,
    card_link,
    margin = "4em",
    transform_anim = true
} = Astro.props;

const parsedTitle = parseTitle(title ?? "");

// Overide CSS variables if defined
const cssVars = {
    '--sliding-cards-margin': `${margin}`,
    '--sliding-cards-hover-transform': transform_anim ? 'translateX(20%) translateY(0)' : 'none'
};
---

<div class="universe-sliding-card-container" style={cssVars}>
    <a href={card_link}>
        <div class="universe-sliding-card">
            <div class="front-content">
                <div class="universe-sliding-card-image-container">
                    {image ? (
                        <img src={image} alt={image_alt}/>
                    ) : (
                        <h3 class="fallback-title" set:html={parsedTitle}></h3>
                    )}
                </div>
            </div>
            <div class="content">
                <p class="heading" set:html={parsedTitle}></p>
                <p>{paragraph}</p>
            </div>
        </div>
    </a>
</div>

<style>
    .universe-sliding-card-container {
        background-color: var(--server-screen-color-bg-card, #2a2a2a);
    }
    
    .fallback-title {
        font-size: 2rem;
        font-weight: 800;
        text-align: center;
        color: var(--default-text-color, #fff);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        margin: 0;
        padding: 1rem;
        box-sizing: border-box;
    }
</style>
