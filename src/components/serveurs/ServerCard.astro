---
interface Props {
    image: string;
    image_alt: string;
    title: string;
    paragraph: string;
    version: string;
    jeu: string;
    type: string;
}

const { image, image_alt, title, paragraph, version, jeu, type } = Astro.props;
---

<div class="card">
    <div class="card-image">
        {image && (
                <img src={image} alt={title ?? 'Image'}/>
        )}
    </div>
    <div class="card-content">
        <h3>{title ?? 'Sans titre'}</h3>
        <p class="description">{paragraph ?? 'Aucune description.'}</p>
        <p class="infos">
            🛠️ Version : {version}
            🌐 Ip
            : {jeu === "palworld" ? "antredesloutres.fr:8211" : type === "primary" ? "antredesloutres.fr" : "secondaire.antredesloutres.fr"}
        </p>
    </div>
</div>

<style>



    .card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: transform 0.2s ease;
    }

    .card:hover {
        transform: scale(1.02);
    }

    .card-image {
        width: 100%;
        height: 260px; /* équivalent de h-65 */
        background: #e5e7eb; /* gray-200 */
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-content {
        padding: 1rem;
        min-height: 160px;
        max-height: 160px;
        overflow: hidden;
    }

    .card-content h3 {
        font-size: 1.125rem; /* text-lg */
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .card-content .description {
        font-size: 0.875rem; /* text-sm */
        color: #4b5563; /* gray-600 */
        margin-bottom: 0.5rem;
    }

    .card-content .infos {
        font-size: 1rem; /* text-md */
        color: #4b5563;
    }
</style>