---
import {slugify} from "../../formater/ServeurFormater";
import type {ServeurType} from "../../types/ServeurType.ts";
import ServerCard from "./ServerCard.astro";
const { apiUrl = '', jeu = '' } = Astro.props;

// Récupération des données depuis l'API
let data
if (apiUrl) {
    const res = await fetch(apiUrl);
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
        data = json.data;
    }
}
---

<div class="grid-container">
    {data.map((item: ServeurType) => (
        <a href={'/serveurs/' + jeu + "/" + slugify(item.nom)} class="card-link">
            <ServerCard image={item.image} image_alt="Server Image" title={item.nom} paragraph={item.description} version={item.version} jeu={item.jeu} type={item.type}/>
        </a>
    ))}
</div>

<style>
    .grid-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1rem 1rem 2.5rem;
        margin: 0 1rem;
    }

    @media (min-width: 950px) {
        .grid-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1500px) {
        .grid-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
