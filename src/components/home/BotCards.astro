---
import { parseTitle } from "../../utils/prettyloutre.ts";

interface Props {
    image: string;
    image_alt: string;
    title: string;
    paragraph: string;
    card_link: string;
}

const { image, image_alt, title, paragraph, card_link } = Astro.props;

const parsedTitle = parseTitle(title ?? "");
---

<div class="universe-sliding-card-container">
    <a href={card_link}>
        <div class="universe-sliding-card">
            <div class="front-content">
                <div class="universe-sliding-card-image-container">
                    <img class="" src={image} alt={image_alt}/>
                </div>
            </div>
            <div class="content">
                <p class="heading" set:html={parsedTitle}></p>
                <p>{paragraph}</p>
            </div>
        </div>
    </a>
</div>